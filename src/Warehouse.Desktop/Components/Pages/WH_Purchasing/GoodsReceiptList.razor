@page "/purchasing/grn"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject BlazorBase.Services.LocalizationService LocalizerService

<div class="wh-page-wrapper" dir="@(IsArabic ? "rtl" : "ltr")">
    <div class="wh-page-header d-flex justify-space-between align-center mb-4">
        <div>
            <MudText MudBlazor.Typo="Typo.h5" Class="wh-title">أذونات استلام البضائع (GRN)</MudText>
            <MudText MudBlazor.Typo="Typo.body2" Color="MudBlazor.Color.Secondary">سجل استلام بضائع الموردين وترحيلها المباشر لسجل المخزون</MudText>
        </div>
        <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.AddShoppingCart"
                   OnClick="OpenCreateGRNDialog">إذن استلام جديد</MudButton>
    </div>

    <MudCard Class="wh-card mb-4">
        <MudCardContent>
            <MudGrid Spacing="3" Class="align-end">
                <MudItem xs="12" sm="5">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color:#475569;">بحث</MudText>
                    <MudTextField @bind-Value="_search" Placeholder="بحث برقم الإذن أو المورد..." MudBlazor.Adornment="MudBlazor.Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Variant="MudBlazor.Variant.Outlined"
                                  Margin="Margin.Dense" InputClass="text-end" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color:#475569;">المستودع</MudText>
                    <MudSelect T="int?" @bind-Value="_warehouseFilter" Variant="MudBlazor.Variant.Outlined"
                               Margin="Margin.Dense" Clearable="true" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="int?" Value="@((int?)null)">-- كل المستودعات --</MudSelectItem>
                        @foreach (var w in _warehouses)
                        {
                            <MudSelectItem T="int?" Value="@((int?)w.Id)">@w.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex align-end pb-1">
                    <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning" StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadData" Style="height: 40px; border-radius: 8px; font-weight: 700; width: 100%;">تحديث</MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudCard Class="wh-card">
        <MudCardContent>
            @if (_loading)
            {
                <MudProgressLinear Color="MudBlazor.Color.Primary" Indeterminate="true" />
            }
            else
            {
                <MudTable Items="FilteredGRNs" Hover="true" Striped="true" Dense="true">
                    <HeaderContent>
                        <MudTh>رقم الإذن</MudTh>
                        <MudTh>رقم أمر الشراء</MudTh>
                        <MudTh>المورد</MudTh>
                        <MudTh>المستودع</MudTh>
                        <MudTh>تاريخ الاستلام</MudTh>
                        <MudTh>فاتورة المورد</MudTh>
                        <MudTh>عدد البنود</MudTh>
                        <MudTh>الإجمالي (ج.م)</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <span class="fw-bold text-orange">@context.GrnNumber</span>
                        </MudTd>
                        <MudTd>@context.OrderNumber</MudTd>
                        <MudTd>@context.SupplierName</MudTd>
                        <MudTd>@context.WarehouseName</MudTd>
                        <MudTd>@context.ReceiptDate.ToString("yyyy/MM/dd HH:mm")</MudTd>
                        <MudTd>@(string.IsNullOrWhiteSpace(context.SupplierInvoiceNumber) ? "-" : context.SupplierInvoiceNumber)</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Default">@context.LinesCount بند</MudChip>
                        </MudTd>
                        <MudTd Class="fw-bold">@context.TotalCost.ToString("N2")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText MudBlazor.Align="MudBlazor.Align.Center" Class="py-6" Color="MudBlazor.Color.Secondary">لا توجد أذونات استلام مطابقة</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudCardContent>
    </MudCard>
</div>

@code {
    private bool IsArabic => LocalizerService.GetCurrentLanguage() == "ar";
    private bool _loading = true;
    private string _search = "";
    private int? _warehouseFilter;

    private List<GRNListItemDto> _grns = new();
    private List<WarehouseLookupDto> _warehouses = new();

    private IEnumerable<GRNListItemDto> FilteredGRNs => _grns.Where(g =>
        (string.IsNullOrWhiteSpace(_search) ||
         g.GrnNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         (g.SupplierName != null && g.SupplierName.Contains(_search, StringComparison.OrdinalIgnoreCase)) ||
         (g.OrderNumber != null && g.OrderNumber.Contains(_search, StringComparison.OrdinalIgnoreCase))) &&
        (!_warehouseFilter.HasValue || g.WarehouseId == _warehouseFilter.Value)
    );

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehouses();
        await LoadData();
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<WarehouseLookupDto>>("api/warehouse/warehouses");
            if (res != null) _warehouses = res;
        }
        catch { }
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            // We fetch approved POs and their GRNs
            var orders = await Http.GetFromJsonAsync<List<POHeaderDto>>("api/warehouse/purchase-orders");
            _grns.Clear();
            if (orders != null)
            {
                foreach (var po in orders)
                {
                    try
                    {
                        var poGrns = await Http.GetFromJsonAsync<List<GRNApiDto>>($"api/warehouse/purchase-orders/{po.Id}/grn");
                        if (poGrns != null)
                        {
                            foreach (var grn in poGrns)
                            {
                                _grns.Add(new GRNListItemDto(
                                    grn.Id,
                                    grn.GrnNumber ?? $"GRN-{grn.Id}",
                                    po.OrderNumber,
                                    po.SupplierName ?? "مورد غير محدد",
                                    po.WarehouseId,
                                    po.WarehouseName ?? "مستودع",
                                    grn.ReceiptDate,
                                    grn.SupplierInvoiceNumber,
                                    grn.Lines?.Count ?? 0,
                                    grn.Lines?.Sum(l => l.QuantityReceived * l.UnitCost) ?? 0m
                                ));
                            }
                        }
                    }
                    catch { }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء جلب أذونات الاستلام: {ex.Message}", MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateGRNDialog()
    {
        var dialog = await DialogService.ShowAsync<GoodsReceiptDialog>("إذن استلام بضاعة جديد",
            new MudBlazor.DialogOptions { MaxWidth = MudBlazor.MaxWidth.Large, FullWidth = true });
        var res = await dialog.Result;
        if (!res.Canceled)
        {
            await LoadData();
        }
    }

    public record GRNListItemDto(
        int Id, string GrnNumber, string OrderNumber, string SupplierName,
        int WarehouseId, string WarehouseName, DateTime ReceiptDate,
        string? SupplierInvoiceNumber, int LinesCount, decimal TotalCost);

    public record POHeaderDto(int Id, string OrderNumber, string? SupplierName, int WarehouseId, string? WarehouseName);
    public record GRNApiDto(int Id, string? GrnNumber, DateTime ReceiptDate, string? SupplierInvoiceNumber, List<GRNLineApiDto>? Lines);
    public record GRNLineApiDto(decimal QuantityReceived, decimal UnitCost);
    public record WarehouseLookupDto(int Id, string NameAr);
}

