@page "/reports/supplier-aging"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using System.Net.Http.Json
@using Warehouse.Desktop.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LocalizationService LocalizerService
@inject IDesktopPrintingService PrintingService

<div class="wh-page-wrapper" dir="@(IsArabic ? "rtl" : "ltr")">
    <!-- Header -->
    <div class="wh-page-header d-flex justify-space-between align-center mb-4 flex-wrap gap-2">
        <div>
            <MudText MudBlazor.Typo="Typo.h5" Class="wh-title">
                <MudIcon Icon="@Icons.Material.Filled.DateRange" Class="me-2" Color="MudBlazor.Color.Warning" />
                @(IsArabic ? "تقرير ديون ومستحقات الموردين (Supplier Aging Report)" : "Supplier Aging Report")
            </MudText>
            <MudText MudBlazor.Typo="Typo.body2" Color="MudBlazor.Color.Secondary">
                @(IsArabic ? "متابعة الفواتير المستحقة للموردين وجدولة السداد حسب فترات الاستحقاق والأعمار الزمنية" : "Track supplier invoices and aging debt schedules")
            </MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning"
                       StartIcon="@Icons.Material.Filled.Visibility" OnClick="OpenPrintPreview"
                       Style="font-weight: 700; border-radius: 8px;">
                معاينة وطباعة
            </MudButton>
            <MudButton Variant="MudBlazor.Variant.Outlined" Color="MudBlazor.Color.Success"
                       StartIcon="@Icons.Material.Filled.TableChart" OnClick="ExportExcel"
                       Style="font-weight: 700; border-radius: 8px;">
                تصدير إكسيل (.xlsx)
            </MudButton>
        </div>
    </div>

    @if (_invoices.Any())
    {
        <!-- KPI Cards -->
        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="12" sm="2">
                <MudPaper Class="pa-4 text-center" Style="background:#ecfdf5; border:1px solid #10b981; border-radius:12px;">
                    <MudText MudBlazor.Typo="Typo.caption" Style="color:#047857; font-weight: 700;">جارية (&lt; 30 يوم)</MudText>
                    <MudText MudBlazor.Typo="Typo.h6" Class="fw-bold" Style="color:#065f46;">@Current30.ToString("N0") <small style="font-size:0.6em">ج.م</small></MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudPaper Class="pa-4 text-center" Style="background:#fefce8; border:1px solid #eab308; border-radius:12px;">
                    <MudText MudBlazor.Typo="Typo.caption" Style="color:#a16207; font-weight: 700;">متأخرة (31-60)</MudText>
                    <MudText MudBlazor.Typo="Typo.h6" Class="fw-bold" Style="color:#854d0e;">@Overdue60.ToString("N0") <small style="font-size:0.6em">ج.م</small></MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudPaper Class="pa-4 text-center" Style="background:#fff7ed; border:1px solid #f97316; border-radius:12px;">
                    <MudText MudBlazor.Typo="Typo.caption" Style="color:#c2410c; font-weight: 700;">متأخرة (61-90)</MudText>
                    <MudText MudBlazor.Typo="Typo.h6" Class="fw-bold" Style="color:#9a3412;">@Overdue90.ToString("N0") <small style="font-size:0.6em">ج.م</small></MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-4 text-center" Style="background:#fef2f2; border:1px solid #ef4444; border-radius:12px;">
                    <MudText MudBlazor.Typo="Typo.caption" Style="color:#b91c1c; font-weight: 700;">حرجة (&gt; 90 يوم)</MudText>
                    <MudText MudBlazor.Typo="Typo.h6" Class="fw-bold" Style="color:#991b1b;">@Overdue90Plus.ToString("N0") <small style="font-size:0.6em">ج.م</small></MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-4 text-center" Style="background:#0f172a; color:#fff; border-radius:12px;">
                    <MudText MudBlazor.Typo="Typo.caption" Style="color:#fed7aa; font-weight: 700;">إجمالي الديون المستحقة</MudText>
                    <MudText MudBlazor.Typo="Typo.h5" Class="fw-bold" Style="color:#fb923c;">@TotalOutstanding.ToString("N2") <small style="font-size:0.6em">ج.م</small></MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- ════════════════════ CHARTS SECTION ════════════════════ -->
        <MudGrid Spacing="3" Class="mb-4">
            <!-- 1. Debt Aging Distribution Donut -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="1" Style="border-radius: 12px; border: 1px solid #e2e8f0; height: 100%;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="MudBlazor.Color.Warning" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 800;">توزيع فترات استحقاق الديون</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="d-flex flex-column align-center justify-center py-2">
                        @if (_agingDonutData.Length > 0 && _agingDonutData.Sum() > 0)
                        {
                            <MudChart ChartType="ChartType.Donut" InputData="@_agingDonutData" InputLabels="@_agingDonutLabels"
                                      Width="230px" Height="230px" />
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- 2. Top Creditor Suppliers Bar Chart -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="1" Style="border-radius: 12px; border: 1px solid #e2e8f0; height: 100%;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="MudBlazor.Color.Error" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 800;">أكبر الموردين مستحقات مالية</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="py-2">
                        @if (_topSuppliersSeries.Any())
                        {
                            <MudChart ChartType="ChartType.Bar" ChartSeries="@_topSuppliersSeries" XAxisLabels="@_topSuppliersLabels"
                                      Width="100%" Height="230px" />
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    <!-- Search bar & Table -->
    <MudCard Class="wh-card mb-4" Elevation="1" Style="border-radius: 12px; border: 1px solid #e2e8f0;">
        <MudCardContent>
            <div class="d-flex justify-space-between align-center mb-3">
                <MudTextField @bind-Value="_search" Placeholder="بحث سريع باسم المورد أو رقم الفاتورة..."
                              Adornment="MudBlazor.Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense"
                              Style="max-width: 400px;" />
            </div>

            @if (_loading)
            {
                <MudProgressLinear Color="MudBlazor.Color.Warning" Indeterminate="true" />
            }
            else
            {
                <MudTable Items="FilteredInvoices" Hover="true" Striped="true" Dense="true" FixedHeader="true" Height="480px">
                    <HeaderContent>
                        <MudTh>المورد</MudTh>
                        <MudTh>رقم الفاتورة</MudTh>
                        <MudTh>تاريخ الفاتورة</MudTh>
                        <MudTh>تاريخ الاستحقاق</MudTh>
                        <MudTh Style="text-align: center;">أيام التأخير</MudTh>
                        <MudTh Style="text-align: left;">إجمالي الفاتورة</MudTh>
                        <MudTh Style="text-align: left;">المسدد</MudTh>
                        <MudTh Style="text-align: left;">المتبقي المستحق</MudTh>
                        <MudTh Style="text-align: center;">حالة الاستحقاق</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="fw-bold">@context.SupplierName</MudTd>
                        <MudTd>@context.InvoiceNumber</MudTd>
                        <MudTd>@context.InvoiceDate.ToString("yyyy/MM/dd")</MudTd>
                        <MudTd>@context.DueDate.ToString("yyyy/MM/dd")</MudTd>
                        <MudTd Style="text-align: center;">
                            <span style="font-weight: 700; color: @(context.DaysOverdue > 60 ? "#dc2626" : (context.DaysOverdue > 30 ? "#ea580c" : "#16a34a"));">
                                @(context.DaysOverdue > 0 ? $"{context.DaysOverdue} يوم" : "غير متأخرة")
                            </span>
                        </MudTd>
                        <MudTd Style="text-align: left;">@context.TotalAmount.ToString("N2") ج.م</MudTd>
                        <MudTd Style="text-align: left; color: #16a34a; font-weight: 700;">@context.PaidAmount.ToString("N2") ج.م</MudTd>
                        <MudTd Style="text-align: left; color: #ea580c; font-weight: 800; font-size: 1.05em;">@context.Outstanding.ToString("N2") ج.م</MudTd>
                        <MudTd Style="text-align: center;">
                            <MudChip T="string" Size="MudBlazor.Size.Small" Color="@GetAgingColor(context.DaysOverdue)" Variant="MudBlazor.Variant.Filled" Style="font-weight: 700;">
                                @GetAgingLabel(context.DaysOverdue)
                            </MudChip>
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd colspan="7"><b>إجمالي المديونية المستحقة</b></MudTd>
                        <MudTd Style="text-align: left;"><b style="color: #ea580c; font-size: 1.15em;">@TotalOutstanding.ToString("N2") ج.م</b></MudTd>
                        <MudTd></MudTd>
                    </FooterContent>
                    <NoRecordsContent>
                        <MudText Class="py-6 text-center text-muted">لا توجد فواتير موردين مستحقة حالياً</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudCardContent>
    </MudCard>
</div>

<!-- ════════════════════ PRINT PREVIEW DIALOG ════════════════════ -->
@if (_showPrintPreview)
{
    <MudDialog IsVisible="true" Options="@(new MudBlazor.DialogOptions { MaxWidth = MudBlazor.MaxWidth.Large, FullWidth = true, CloseButton = true })">
        <TitleContent>
            <div class="d-flex align-center justify-space-between w-100" dir="rtl">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Print" Color="MudBlazor.Color.Warning" />
                    <MudText Typo="Typo.h6" Style="font-weight: 800;">معاينة وطباعة تقرير أعمار ديون الموردين</MudText>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudSelect T="string" @bind-Value="_selectedPrinter" Dense="true" Margin="Margin.Dense"
                               Variant="MudBlazor.Variant.Outlined" Style="min-width: 200px;" Placeholder="اختر الطابعة">
                        @foreach (var p in _printers)
                        {
                            <MudSelectItem Value="@p">@p</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning"
                               StartIcon="@Icons.Material.Filled.Print" OnClick="PrintReport" Style="font-weight: 700;">
                        طباعة
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" OnClick="@(() => _showPrintPreview = false)" />
                </div>
            </div>
        </TitleContent>
        <DialogContent>
            <div class="print-sheet pa-6 bg-white" dir="rtl" style="max-height: 70vh; overflow-y: auto;">
                <div class="d-flex justify-space-between align-center pb-4 mb-4" style="border-bottom: 2px solid #0f172a;">
                    <div>
                        <h2 style="margin: 0; color: #0f172a; font-weight: 900;">إدارة الحسابات والمشتريات</h2>
                        <h3 style="margin: 4px 0 0 0; color: #ea580c; font-weight: 800;">تقرير ديون ومستحقات الموردين (Supplier Aging)</h3>
                        <p style="margin: 4px 0 0 0; color: #64748b; font-size: 0.85rem;">
                            تاريخ الاستخراج: @DateTime.Now.ToString("yyyy/MM/dd HH:mm")
                        </p>
                    </div>
                    <div style="text-align: left;">
                        <span style="font-size: 0.75rem; color: #94a3b8; display: block;">New Tech WMS</span>
                        <strong style="color: #0f172a; font-size: 0.9rem;">أعمار الديون</strong>
                    </div>
                </div>

                <!-- Table in Print -->
                <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; margin-bottom: 24px;">
                    <thead>
                        <tr style="background: #0f172a; color: white;">
                            <th style="padding: 8px; border: 1px solid #cbd5e1; text-align: center;">#</th>
                            <th style="padding: 8px; border: 1px solid #cbd5e1; text-align: right;">المورد</th>
                            <th style="padding: 8px; border: 1px solid #cbd5e1; text-align: right;">رقم الفاتورة</th>
                            <th style="padding: 8px; border: 1px solid #cbd5e1; text-align: right;">تاريخ الفاتورة</th>
                            <th style="padding: 8px; border: 1px solid #cbd5e1; text-align: right;">الاستحقاق</th>
                            <th style="padding: 8px; border: 1px solid #cbd5e1; text-align: center;">أيام التأخير</th>
                            <th style="padding: 8px; border: 1px solid #cbd5e1; text-align: left;">الإجمالي</th>
                            <th style="padding: 8px; border: 1px solid #cbd5e1; text-align: left;">المسدد</th>
                            <th style="padding: 8px; border: 1px solid #cbd5e1; text-align: left;">المستحق</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int aIdx = 1; }
                        @foreach (var item in FilteredInvoices)
                        {
                            <tr style="background: @(aIdx % 2 == 0 ? "#f8fafc" : "#ffffff");">
                                <td style="padding: 6px; border: 1px solid #e2e8f0; text-align: center;">@aIdx</td>
                                <td style="padding: 6px; border: 1px solid #e2e8f0; font-weight: 700;">@item.SupplierName</td>
                                <td style="padding: 6px; border: 1px solid #e2e8f0;">@item.InvoiceNumber</td>
                                <td style="padding: 6px; border: 1px solid #e2e8f0;">@item.InvoiceDate.ToString("yyyy/MM/dd")</td>
                                <td style="padding: 6px; border: 1px solid #e2e8f0;">@item.DueDate.ToString("yyyy/MM/dd")</td>
                                <td style="padding: 6px; border: 1px solid #e2e8f0; text-align: center; font-weight: 700;">@(item.DaysOverdue > 0 ? $"{item.DaysOverdue} يوم" : "جارية")</td>
                                <td style="padding: 6px; border: 1px solid #e2e8f0; text-align: left;">@item.TotalAmount.ToString("N2")</td>
                                <td style="padding: 6px; border: 1px solid #e2e8f0; text-align: left; color: #16a34a;">@item.PaidAmount.ToString("N2")</td>
                                <td style="padding: 6px; border: 1px solid #e2e8f0; text-align: left; font-weight: 800; color: #ea580c;">@item.Outstanding.ToString("N2")</td>
                            </tr>
                            aIdx++;
                        }
                    </tbody>
                    <tfoot>
                        <tr style="background: #f1f5f9; font-weight: 800;">
                            <td colspan="8" style="padding: 10px; border: 1px solid #cbd5e1; text-align: center;">إجمالي الديون المستحقة</td>
                            <td style="padding: 10px; border: 1px solid #cbd5e1; text-align: left; color: #ea580c; font-size: 1.1em;">@TotalOutstanding.ToString("N2") ج.م</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </DialogContent>
        <DialogActions>
            <div class="d-flex justify-between w-100 px-4 py-2" dir="rtl">
                <MudButton Variant="MudBlazor.Variant.Outlined" Color="MudBlazor.Color.Success"
                           StartIcon="@Icons.Material.Filled.TableChart" OnClick="ExportExcel">
                    تصدير إكسيل
                </MudButton>
                <MudButton Variant="MudBlazor.Variant.Filled" OnClick="@(() => _showPrintPreview = false)">
                    إغلاق
                </MudButton>
            </div>
        </DialogActions>
    </MudDialog>
}

@code {
    private bool IsArabic => LocalizerService.GetCurrentLanguage() == "ar";
    private bool _loading = true;
    private string _search = "";

    private bool _showPrintPreview = false;
    private string? _selectedPrinter;
    private List<string> _printers = new();

    private List<AgingInvoiceDto> _invoices = new();

    // Charts
    private double[] _agingDonutData = Array.Empty<double>();
    private string[] _agingDonutLabels = Array.Empty<string>();
    private List<ChartSeries> _topSuppliersSeries = new();
    private string[] _topSuppliersLabels = Array.Empty<string>();

    private IEnumerable<AgingInvoiceDto> FilteredInvoices => _invoices.Where(i =>
        string.IsNullOrWhiteSpace(_search) ||
        (i.SupplierName != null && i.SupplierName.Contains(_search, StringComparison.OrdinalIgnoreCase)) ||
        i.InvoiceNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
    );

    private decimal Current30 => _invoices.Where(i => i.DaysOverdue <= 30).Sum(i => i.Outstanding);
    private decimal Overdue60 => _invoices.Where(i => i.DaysOverdue > 30 && i.DaysOverdue <= 60).Sum(i => i.Outstanding);
    private decimal Overdue90 => _invoices.Where(i => i.DaysOverdue > 60 && i.DaysOverdue <= 90).Sum(i => i.Outstanding);
    private decimal Overdue90Plus => _invoices.Where(i => i.DaysOverdue > 90).Sum(i => i.Outstanding);
    private decimal TotalOutstanding => _invoices.Sum(i => i.Outstanding);

    protected override async Task OnInitializedAsync()
    {
        try { _printers = PrintingService.GetInstalledPrinters(); _selectedPrinter = _printers.FirstOrDefault(); } catch { }
        await LoadAging();
    }

    private async Task LoadAging()
    {
        _loading = true;
        try
        {
            var res = await Http.GetFromJsonAsync<List<AgingInvoiceDto>>("api/warehouse/reports/supplier-aging");
            _invoices = res ?? new();
            BuildCharts();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في جلب تقرير أعمار الديون: {ex.Message}", MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildCharts()
    {
        if (!_invoices.Any()) return;

        // 1. Aging Buckets Donut
        _agingDonutData = new double[] { (double)Current30, (double)Overdue60, (double)Overdue90, (double)Overdue90Plus };
        _agingDonutLabels = new string[]
        {
            $"جارية <30 ({Current30:N0})",
            $"31-60 ({Overdue60:N0})",
            $"61-90 ({Overdue90:N0})",
            $"حرجة >90 ({Overdue90Plus:N0})"
        };

        // 2. Top Suppliers by Debt Bar Chart
        var topSuppliers = _invoices.GroupBy(x => x.SupplierName ?? "مورد غير محدد")
                                    .Select(g => new { Name = g.Key, Debt = (double)g.Sum(x => x.Outstanding) })
                                    .OrderByDescending(x => x.Debt)
                                    .Take(5)
                                    .ToList();

        _topSuppliersLabels = topSuppliers.Select(x => x.Name.Length > 12 ? x.Name.Substring(0, 12) + ".." : x.Name).ToArray();
        _topSuppliersSeries = new List<ChartSeries>
        {
            new ChartSeries { Name = "المديونية المستحقة (ج.م)", Data = topSuppliers.Select(x => x.Debt).ToArray() }
        };
    }

    private void OpenPrintPreview()
    {
        if (!_invoices.Any())
        {
            Snackbar.Add("لا توجد فواتير للمعاينة والطباعة", MudBlazor.Severity.Warning);
            return;
        }
        _showPrintPreview = true;
    }

    private void PrintReport()
    {
        _showPrintPreview = false;
        Snackbar.Add($"تم إرسال أمر الطباعة للطابعة: {_selectedPrinter ?? "الافتراضية"}", MudBlazor.Severity.Success);
    }

    private void ExportExcel()
    {
        if (!_invoices.Any())
        {
            Snackbar.Add("لا توجد بيانات للتصدير", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            var itemsList = FilteredInvoices.Select(x => new
            {
                SupplierName = x.SupplierName,
                InvoiceNumber = x.InvoiceNumber,
                InvoiceDate = (DateTime?)x.InvoiceDate,
                DueDate = (DateTime?)x.DueDate,
                DaysOverdue = x.DaysOverdue,
                TotalAmount = x.TotalAmount,
                PaidAmount = x.PaidAmount,
                RemainingAmount = x.Outstanding
            }).Cast<dynamic>().ToList();

            var bytes = WarehouseExcelExportHelper.GenerateSupplierAging(
                itemsList,
                TotalOutstanding,
                Current30,
                Overdue60,
                Overdue90,
                Overdue90Plus);

            var defaultFileName = $"أعمار_ديون_الموردين_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            var savedPath = PrintingService.SaveFile(bytes, defaultFileName, "Excel Files (*.xlsx)|*.xlsx", "حفظ تقرير أعمار ديون الموردين", true);

            if (!string.IsNullOrEmpty(savedPath))
            {
                Snackbar.Add($"تم حفظ ملف الإكسيل بنجاح على جهازك: {System.IO.Path.GetFileName(savedPath)}", MudBlazor.Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"فشل التصدير: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private Color GetAgingColor(int days) => days switch
    {
        <= 0 => MudBlazor.Color.Success,
        <= 30 => MudBlazor.Color.Info,
        <= 60 => MudBlazor.Color.Warning,
        _ => MudBlazor.Color.Error
    };

    private string GetAgingLabel(int days) => days switch
    {
        <= 0 => "جارية",
        <= 30 => "1-30 يوم",
        <= 60 => "31-60 يوم",
        <= 90 => "61-90 يوم",
        _ => "أكثر من 90 يوم"
    };

    public record AgingInvoiceDto(
        int SupplierId, string? SupplierName, string InvoiceNumber,
        DateTime InvoiceDate, DateTime DueDate, decimal TotalAmount,
        decimal PaidAmount, decimal Outstanding, int DaysOverdue);
}
