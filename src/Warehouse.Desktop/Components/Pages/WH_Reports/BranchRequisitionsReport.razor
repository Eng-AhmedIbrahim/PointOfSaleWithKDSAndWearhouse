    private void ExportToExcel()
    {
        if (!_filteredRequisitions.Any())
        {
            Snackbar.Add("لا توجد بيانات للتصدير", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            var branchList = _branchComparisons.Select(b => new
            {
                BranchName = b.BranchName,
                TotalOrders = b.TotalOrders,
                ReceivedOrders = b.ReceivedOrders,
                PendingOrders = b.PendingOrders,
                TotalRequestedQty = b.TotalRequestedQty,
                TotalDeliveredQty = b.TotalDeliveredQty,
                FulfillmentRate = b.FulfillmentRate
            }).Cast<dynamic>().ToList();

            var reqDetailsList = new List<dynamic>();
            foreach (var r in _filteredRequisitions)
            {
                foreach (var line in r.Lines)
                {
                    reqDetailsList.Add(new
                    {
                        RequisitionNumber = r.RequisitionNumber,
                        BranchName = r.BranchName,
                        WarehouseName = r.WarehouseName,
                        RequestDate = (DateTime?)r.RequestDate,
                        ProductCode = line.ProductCode,
                        ProductName = line.ProductName,
                        UnitName = line.UnitName,
                        RequestedQty = line.RequestedQuantity,
                        DeliveredQty = line.ReceivedQuantity ?? line.ApprovedQuantity ?? 0m,
                        StatusLabel = GetStatusLabel(r.Status)
                    });
                }
            }

            var bytes = WarehouseExcelExportHelper.GenerateBranchRequisitionsReport(
                SelectedBranchName,
                SelectedWarehouseName,
                SelectedStatusName,
                _fromDate,
                _toDate,
                branchList,
                reqDetailsList);

            var defaultFileName = $"تقرير_مقارنة_طلبيات_الفروع_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            var savedPath = PrintingService.SaveFile(bytes, defaultFileName, "Excel Files (*.xlsx)|*.xlsx", "حفظ تقرير طلبيات الفروع", true);

            if (!string.IsNullOrEmpty(savedPath))
            {
                Snackbar.Add($"تم حفظ ملف الإكسيل بنجاح: {System.IO.Path.GetFileName(savedPath)}", MudBlazor.Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"فشل تصدير الإكسيل: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

