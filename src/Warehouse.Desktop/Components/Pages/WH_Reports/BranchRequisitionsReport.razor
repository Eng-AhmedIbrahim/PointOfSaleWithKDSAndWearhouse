        (9, "مستلم"),
        (10, "مرفوض"),
        (11, "ملغي")
    };

    private string SelectedBranchName => _selectedBranchId.HasValue ? _branches.FirstOrDefault(b => b.Id == _selectedBranchId.Value)?.Name ?? "الفرع" : "كل الفروع";
    private string SelectedWarehouseName => _selectedWarehouseId.HasValue ? _warehouses.FirstOrDefault(w => w.Id == _selectedWarehouseId.Value)?.Name ?? "المخزن" : "كل المخازن";
    private string SelectedStatusName => _selectedStatus.HasValue ? GetStatusLabel(_selectedStatus.Value) : "كل الحالات";

    private IEnumerable<RequisitionFullDto> SearchedRequisitions
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchText)) return _filteredRequisitions;
            var q = _searchText.Trim().ToLower();
            return _filteredRequisitions.Where(r =>
                r.RequisitionNumber.ToLower().Contains(q) ||
                (r.BranchName ?? "").ToLower().Contains(q) ||
                (r.WarehouseName ?? "").ToLower().Contains(q) ||
                r.Lines.Any(l => l.ProductName.ToLower().Contains(q) || (l.ProductCode ?? "").ToLower().Contains(q)));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadData();
    }

    private async Task LoadLookups()
    {
        try
        {
            var branchResult = await Http.GetFromJsonAsync<List<BranchSimpleDto>>("api/branch/GetAllBranches");
            if (branchResult != null)
            {
                _branches = branchResult.Select(b => new LookupItem { Id = b.Id, Name = b.Name ?? $"فرع {b.Id}" }).ToList();
            }
        }
        catch
        {
            try
            {
                var branchResult = await Http.GetFromJsonAsync<List<BranchSimpleDto>>("api/branches");
                if (branchResult != null)
                {
                    _branches = branchResult.Select(b => new LookupItem { Id = b.Id, Name = b.Name ?? $"فرع {b.Id}" }).ToList();
                }
            }
            catch { }
        }

        try
        {
            var whResult = await Http.GetFromJsonAsync<List<WarehouseSimpleDto>>("api/warehouses");
            if (whResult != null)
            {
                _warehouses = whResult.Select(w => new LookupItem { Id = w.Id, Name = w.NameAr ?? w.DisplayName ?? $"مستودع {w.Id}" }).ToList();
            }
        }
        catch { }
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var url = "api/warehouse/requisitions";
            var queryParams = new List<string>();
            if (_selectedStatus.HasValue) queryParams.Add($"status={_selectedStatus.Value}");
            if (_selectedBranchId.HasValue) queryParams.Add($"branchId={_selectedBranchId.Value}");
            if (_selectedWarehouseId.HasValue) queryParams.Add($"warehouseId={_selectedWarehouseId.Value}");
            if (_fromDate.HasValue) queryParams.Add($"from={_fromDate.Value:yyyy-MM-dd}");
            if (_toDate.HasValue) queryParams.Add($"to={_toDate.Value:yyyy-MM-ddT23:59:59}");

            if (queryParams.Any())
            {
                url += "?" + string.Join("&", queryParams);
            }

            _allRequisitions = await Http.GetFromJsonAsync<List<RequisitionFullDto>>(url) ?? new();
            ComputeAnalytics();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء جلب طلبيات الفروع: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ComputeAnalytics()
    {
        _filteredRequisitions = _allRequisitions;

        _receivedOrdersCount = _filteredRequisitions.Count(r => r.Status == 9);
        _pendingOrdersCount = _filteredRequisitions.Count(r => r.Status == 2 || r.Status == 3 || r.Status == 4 || r.Status == 5 || r.Status == 7 || r.Status == 8);

        _totalRequestedQty = _filteredRequisitions.Sum(r => r.Lines.Sum(l => l.RequestedQuantity));
        _totalDeliveredQty = _filteredRequisitions.Sum(r => r.Lines.Sum(l => l.ReceivedQuantity ?? l.ApprovedQuantity ?? 0));

        _overallFulfillmentRate = _totalRequestedQty > 0 ? (_totalDeliveredQty / _totalRequestedQty * 100m) : 0m;

        // Group by Branch for Comparison
        int idx = 1;
        _branchComparisons = _filteredRequisitions
            .GroupBy(r => !string.IsNullOrEmpty(r.BranchName) ? r.BranchName : "فرع غير محدد")
            .Select(g =>
            {
                var totalReq = g.Sum(r => r.Lines.Sum(l => l.RequestedQuantity));
                var totalDeliv = g.Sum(r => r.Lines.Sum(l => l.ReceivedQuantity ?? l.ApprovedQuantity ?? 0));
                var rate = totalReq > 0 ? (totalDeliv / totalReq * 100m) : 0m;
                return new BranchComparisonItem
                {
                    Index = idx++,
                    BranchName = g.Key,
                    TotalOrders = g.Count(),
                    ReceivedOrders = g.Count(r => r.Status == 9),
                    PendingOrders = g.Count(r => r.Status != 9 && r.Status != 10 && r.Status != 11),
                    TotalRequestedQty = totalReq,
                    TotalDeliveredQty = totalDeliv,
                    FulfillmentRate = rate
                };
            }).OrderByDescending(b => b.TotalOrders).ToList();
    }

