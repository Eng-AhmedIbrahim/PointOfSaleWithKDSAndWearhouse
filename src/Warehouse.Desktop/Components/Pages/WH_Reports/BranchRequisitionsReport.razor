@page "/reports/branch-requisitions"
@page "/warehouse/reports/branch-requisitions"
@attribute [Authorize]
@using Warehouse.Desktop.Services
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDesktopPrintingService PrintingService

<PageTitle>تقرير مقارنة وتحليل طلبيات الفروع والمستودعات</PageTitle>

<div class="wh-page-wrapper" dir="rtl">
    <!-- Header -->
    <div class="wh-page-header d-flex justify-space-between align-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="page-title">
                <MudIcon Icon="@Icons.Material.Rounded.CompareArrows" Class="me-2" Color="MudBlazor.Color.Warning" />
                تقرير مقارنة وتحليل طلبيات الفروع والمستودعات
            </h2>
            <p class="page-subtitle">تحليل شامل لحركات وتعديلات طلبيات الفروع، ومقارنة معدلات الطلب والتوريد بين الفروع والمخازن</p>
        </div>
        <div class="d-flex gap-2 align-center flex-wrap">
            <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning"
                       StartIcon="@Icons.Material.Filled.Visibility" OnClick="OpenPrintPreview"
                       Style="font-weight: 700; border-radius: 8px;">
                معاينة وطباعة (A4)
            </MudButton>
            <MudButton Variant="MudBlazor.Variant.Outlined" Color="MudBlazor.Color.Success"
                       StartIcon="@Icons.Material.Filled.TableChart" OnClick="ExportToExcel"
                       Style="font-weight: 700; border-radius: 8px;">
                تصدير إكسيل (.xlsx)
            </MudButton>
        </div>
    </div>

    <!-- Filters Section -->
    <MudPaper Class="wh-card mb-4 pa-4" Elevation="1" Style="border-radius: 12px; border: 1px solid #e2e8f0;">
        <MudGrid Spacing="3" Class="align-center">
            <!-- From Date -->
            <MudItem xs="12" sm="6" md="2">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-muted">من تاريخ</MudText>
                <MudDatePicker @bind-Date="_fromDate" Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" DateFormat="yyyy-MM-dd" />
            </MudItem>

            <!-- To Date -->
            <MudItem xs="12" sm="6" md="2">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-muted">إلى تاريخ</MudText>
                <MudDatePicker @bind-Date="_toDate" Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" DateFormat="yyyy-MM-dd" />
            </MudItem>

            <!-- Branch Selector -->
            <MudItem xs="12" sm="6" md="2">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-muted">الفرع الطالب</MudText>
                <MudSelect T="int?" @bind-Value="_selectedBranchId" Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="int?" Value="@((int?)null)">كل الفروع</MudSelectItem>
                    @foreach (var b in _branches)
                    {
                        <MudSelectItem T="int?" Value="@((int?)b.Id)">@b.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Warehouse Selector -->
            <MudItem xs="12" sm="6" md="2">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-muted">المخزن المورد</MudText>
                <MudSelect T="int?" @bind-Value="_selectedWarehouseId" Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="int?" Value="@((int?)null)">كل المخازن</MudSelectItem>
                    @foreach (var w in _warehouses)
                    {
                        <MudSelectItem T="int?" Value="@((int?)w.Id)">@w.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Status Selector -->
            <MudItem xs="12" sm="6" md="2">
                <MudText Typo="Typo.caption" Class="fw-bold mb-1 d-block text-muted">حالة الطلبية</MudText>
                <MudSelect T="int?" @bind-Value="_selectedStatus" Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="int?" Value="@((int?)null)">كل الحالات</MudSelectItem>
                    @foreach (var s in _statusList)
                    {
                        <MudSelectItem T="int?" Value="@s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Search & Refresh Buttons -->
            <MudItem xs="12" sm="6" md="2" Class="d-flex align-end gap-2 pt-5">
                <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning" OnClick="ApplyFilter" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Search" Style="font-weight: 700; height: 40px; border-radius: 8px;">
                    تحديث
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="MudBlazor.Color.Default" Variant="MudBlazor.Variant.Outlined"
                               OnClick="ResetFilters" Title="إعادة تعيين الفلاتر" Style="height: 40px; width: 40px; border-radius: 8px;" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loading)
    {
        <div class="text-center pa-12">
            <MudProgressCircular Color="MudBlazor.Color.Warning" Indeterminate="true" Size="MudBlazor.Size.Large" />
            <MudText Typo="Typo.body2" Class="mt-2 text-muted">جاري تحميل وتحليل بيانات طلبيات الفروع...</MudText>
        </div>
    }
    else
    {
        <!-- KPI Summary Cards -->
        <MudGrid Spacing="3" Class="mb-4">
            <!-- 1. Total Requisitions -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="wh-card pa-3" Elevation="1" Style="border-radius: 12px; border-right: 4px solid #f97316;">
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.caption" Class="text-muted fw-bold">إجمالي الطلبيات</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight: 900; color: #ea580c;">@_filteredRequisitions.Count طلبية</MudText>
                        </div>
                        <div class="pa-2 rounded-lg" style="background: #ffedd5; color: #ea580c;">
                            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="MudBlazor.Size.Medium" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- 2. Received Orders -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="wh-card pa-3" Elevation="1" Style="border-radius: 12px; border-right: 4px solid #16a34a;">
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.caption" Class="text-muted fw-bold">طلبيات مستلمة بالكامل</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight: 900; color: #16a34a;">@_receivedOrdersCount طلبية</MudText>
                        </div>
                        <div class="pa-2 rounded-lg" style="background: #dcfce7; color: #16a34a;">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="MudBlazor.Size.Medium" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- 3. Pending / In Progress Orders -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="wh-card pa-3" Elevation="1" Style="border-radius: 12px; border-right: 4px solid #3b82f6;">
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.caption" Class="text-muted fw-bold">قيد التجهيز والمراجعة</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight: 900; color: #2563eb;">@_pendingOrdersCount طلبية</MudText>
                        </div>
                        <div class="pa-2 rounded-lg" style="background: #dbeafe; color: #2563eb;">
                            <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="MudBlazor.Size.Medium" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- 4. Fulfillment Rate & Total Quantity -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="wh-card pa-3" Elevation="1" Style="border-radius: 12px; border-right: 4px solid #8b5cf6;">
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.caption" Class="text-muted fw-bold">نسبة التوريد والوفاء</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight: 900; color: #7c3aed;">@($"{_overallFulfillmentRate:0.#}%")</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">(@_totalDeliveredQty.ToString("0.##") من @_totalRequestedQty.ToString("0.##") وحدة)</MudText>
                        </div>
                        <div class="pa-2 rounded-lg" style="background: #ede9fe; color: #7c3aed;">
                            <MudIcon Icon="@Icons.Material.Filled.Insights" Size="MudBlazor.Size.Medium" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- ════════════════════ SECTION 1: BRANCH COMPARISON ════════════════════ -->
        <MudCard Class="wh-card mb-4" Elevation="1" Style="border-radius: 12px; border: 1px solid #e2e8f0;">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Rounded.BarChart" Color="MudBlazor.Color.Warning" />
                        <MudText Typo="Typo.h6" Style="font-weight: 800; color: #0f172a;">مقارنة الفروع في الطلبيات والتوريد</MudText>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pt-0">
                <MudTable Items="_branchComparisons" Dense="true" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>اسم الفرع</MudTh>
                        <MudTh Style="text-align: center;">إجمالي الطلبيات</MudTh>
                        <MudTh Style="text-align: center;">المستلمة</MudTh>
                        <MudTh Style="text-align: center;">قيد التنفيذ / المراجعة</MudTh>
                        <MudTh Style="text-align: center;">إجمالي الكميات المطلوبة</MudTh>
                        <MudTh Style="text-align: center;">إجمالي الكميات الموردة</MudTh>
                        <MudTh Style="text-align: center;">معدل الوفاء بالطلب</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Index</MudTd>
                        <MudTd><strong style="color: #0f172a;">@context.BranchName</strong></MudTd>
                        <MudTd Style="text-align: center; font-weight: 700; color: #ea580c;">@context.TotalOrders</MudTd>
                        <MudTd Style="text-align: center; font-weight: 700; color: #16a34a;">@context.ReceivedOrders</MudTd>
                        <MudTd Style="text-align: center; font-weight: 700; color: #2563eb;">@context.PendingOrders</MudTd>
                        <MudTd Style="text-align: center; font-weight: 700;">@context.TotalRequestedQty.ToString("0.##")</MudTd>
                        <MudTd Style="text-align: center; font-weight: 700; color: #16a34a;">@context.TotalDeliveredQty.ToString("0.##")</MudTd>
                        <MudTd Style="text-align: center;">
                            <MudChip T="string" Size="MudBlazor.Size.Small" Color="@(context.FulfillmentRate >= 80 ? MudBlazor.Color.Success : context.FulfillmentRate >= 50 ? MudBlazor.Color.Warning : MudBlazor.Color.Error)" Variant="MudBlazor.Variant.Filled" Style="font-weight: 700;">
                                @($"{context.FulfillmentRate:0.#}%")
                            </MudChip>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="text-center pa-4 text-muted">لا توجد بيانات مقارنة للفروع في الفترة المحددة</div>
                    </NoRecordsContent>
                </MudTable>
            </MudCardContent>
        </MudCard>

        <!-- ════════════════════ SECTION 2: DETAILED REQUISITIONS LIST ════════════════════ -->
        <MudCard Class="wh-card" Elevation="1" Style="border-radius: 12px; border: 1px solid #e2e8f0;">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex justify-space-between align-center w-100 flex-wrap gap-2">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Rounded.FormatListBulleted" Color="MudBlazor.Color.Warning" />
                            <MudText Typo="Typo.h6" Style="font-weight: 800; color: #0f172a;">
                                سجل تفاصيل الطلبيات وحركات التعديل (@_filteredRequisitions.Count طلبية)
                            </MudText>
                        </div>
                        <div style="min-width: 250px;">
                            <MudTextField T="string" @bind-Value="_searchText" Placeholder="بحث برقم الطلبية أو الصنف أو الفرع..."
                                          Adornment="MudBlazor.Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                          Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" Clearable="true" />
                        </div>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pt-0">
                <MudTable Items="SearchedRequisitions" Dense="true" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>رقم الطلب</MudTh>
                        <MudTh>الفرع الطالب</MudTh>
                        <MudTh>المستودع المورد</MudTh>
                        <MudTh>تاريخ الطلب</MudTh>
                        <MudTh Style="text-align: center;">الأصناف</MudTh>
                        <MudTh Style="text-align: center;">إجمالي المطلوب</MudTh>
                        <MudTh Style="text-align: center;">إجمالي المستلم</MudTh>
                        <MudTh Style="text-align: center;">الحالة</MudTh>
                        <MudTh Style="text-align: center;">الإجراءات</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><strong style="color: #ea580c;">@context.RequisitionNumber</strong></MudTd>
                        <MudTd>@context.BranchName</MudTd>
                        <MudTd>@context.WarehouseName</MudTd>
                        <MudTd>@context.RequestDate.ToString("yyyy/MM/dd hh:mm tt")</MudTd>
                        <MudTd Style="text-align: center;">
                            <MudChip T="string" Size="MudBlazor.Size.Small" Variant="MudBlazor.Variant.Outlined">
                                @context.Lines.Count صنف
                            </MudChip>
                        </MudTd>
                        <MudTd Style="text-align: center; font-weight: 700;">@context.Lines.Sum(l => l.RequestedQuantity).ToString("0.##")</MudTd>
                        <MudTd Style="text-align: center; font-weight: 700; color: #16a34a;">@context.Lines.Sum(l => l.ReceivedQuantity ?? l.ApprovedQuantity ?? 0).ToString("0.##")</MudTd>
                        <MudTd Style="text-align: center;">
                            <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="MudBlazor.Size.Small" Variant="MudBlazor.Variant.Filled" Style="font-weight: 700;">
                                @GetStatusLabel(context.Status)
                            </MudChip>
                        </MudTd>
                        <MudTd Style="text-align: center;">
                            <div class="d-flex justify-center gap-1">
                                <MudIconButton Icon="@Icons.Material.Rounded.Inventory2" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Info"
                                               OnClick="@(() => OpenItemsDialog(context))" Title="عرض الأصناف بالتفصيل" />
                                <MudIconButton Icon="@Icons.Material.Rounded.History" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Primary"
                                               OnClick="@(() => OpenLogsDialog(context))" Title="سجل الحركات والتعديلات التي تمت" />
                                <MudIconButton Icon="@Icons.Material.Filled.Print" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Warning"
                                               OnClick="@(() => OpenPrintVoucher(context))" Title="طباعة إذن الصرف (نسخة المخزن والفرع)" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="text-center pa-6 text-muted">لا توجد طلبيات مطابقة للبحث والفلاتر</div>
                    </NoRecordsContent>
                </MudTable>
            </MudCardContent>
        </MudCard>
    }
</div>

<!-- ════════════════════ ITEMS DRILL-DOWN DIALOG ════════════════════ -->
<MudDialog @bind-IsVisible="_showItemsDialog" Options="_dialogOptions" dir="rtl">
    <TitleContent>
        <div class="d-flex align-center justify-space-between w-100 pa-1 border-b">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Rounded.Inventory2" Color="MudBlazor.Color.Warning" />
                <MudText Typo="Typo.h6" Style="font-weight: 800; color: #0f172a;">
                    أصناف الطلبية - @(_selectedReqForDialog?.RequisitionNumber ?? "")
                </MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Rounded.Close" OnClick="@(() => _showItemsDialog = false)" />
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedReqForDialog != null)
        {
            <div class="pa-2">
                <div class="d-flex gap-4 mb-3 text-muted" style="font-size: 0.85rem;">
                    <div>الفرع: <strong>@_selectedReqForDialog.BranchName</strong></div>
                    <div>المستودع: <strong>@_selectedReqForDialog.WarehouseName</strong></div>
                    <div>التاريخ: <strong>@_selectedReqForDialog.RequestDate.ToString("yyyy/MM/dd hh:mm tt")</strong></div>
                </div>

                <MudTable Items="_selectedReqForDialog.Lines" Dense="true" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>كود الصنف</MudTh>
                        <MudTh>اسم الصنف</MudTh>
                        <MudTh Style="text-align: center;">الوحدة</MudTh>
                        <MudTh Style="text-align: center;">المطلوب</MudTh>
                        <MudTh Style="text-align: center;">المعتمد</MudTh>
                        <MudTh Style="text-align: center;">المنصرف</MudTh>
                        <MudTh Style="text-align: center;">المستلم</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Id</MudTd>
                        <MudTd><code style="color: #64748b;">@context.ProductCode</code></MudTd>
                        <MudTd><strong>@context.ProductName</strong></MudTd>
                        <MudTd Style="text-align: center;">@context.UnitName</MudTd>
                        <MudTd Style="text-align: center; font-weight: 700;">@context.RequestedQuantity.ToString("0.##")</MudTd>
                        <MudTd Style="text-align: center; font-weight: 700; color: #16a34a;">@(context.ApprovedQuantity?.ToString("0.##") ?? "-")</MudTd>
                        <MudTd Style="text-align: center; font-weight: 700; color: #ea580c;">@(context.DispatchedQuantity?.ToString("0.##") ?? "-")</MudTd>
                        <MudTd Style="text-align: center; font-weight: 700; color: #2563eb;">@(context.ReceivedQuantity?.ToString("0.##") ?? "-")</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        }
    </DialogContent>
</MudDialog>

<!-- ════════════════════ AUDIT / MOVEMENT LOGS DIALOG ════════════════════ -->
<MudDialog @bind-IsVisible="_showLogsDialog" Options="_dialogOptions" dir="rtl">
    <TitleContent>
        <div class="d-flex align-center justify-space-between w-100 pa-1 border-b">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Rounded.History" Color="MudBlazor.Color.Primary" />
                <MudText Typo="Typo.h6" Style="font-weight: 800; color: #0f172a;">
                    سجل الحركات والتعديلات التي تمت على الطلبية - @(_selectedReqForDialog?.RequisitionNumber ?? "")
                </MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Rounded.Close" OnClick="@(() => _showLogsDialog = false)" />
        </div>
    </TitleContent>
    <DialogContent>
        @if (_logsLoading)
        {
            <div class="text-center pa-8">
                <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" Size="MudBlazor.Size.Medium" />
                <MudText Typo="Typo.body2" Class="mt-2 text-muted">جاري تحميل سجل التعديلات...</MudText>
            </div>
        }
        else if (!_requisitionLogs.Any())
        {
            <div class="text-center pa-6 text-muted">
                <MudIcon Icon="@Icons.Material.Rounded.Info" Size="MudBlazor.Size.Large" Class="mb-2" />
                <p>لا توجد حركات مسجلة إضافية على هذه الطلبية</p>
            </div>
        }
        else
        {
            <div class="pa-2">
                <MudTable Items="_requisitionLogs" Dense="true" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>توقيت الحركة</MudTh>
                        <MudTh>نوع الحدث</MudTh>
                        <MudTh>الحالة السابقة</MudTh>
                        <MudTh>الحالة الجديدة</MudTh>
                        <MudTh>الوصف والتفاصيل</MudTh>
                        <MudTh>المسؤول</MudTh>
                        <MudTh>الدور</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><strong>@context.EventDate.ToLocalTime().ToString("yyyy/MM/dd hh:mm tt")</strong></MudTd>
                        <MudTd><MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Default">@context.EventType</MudChip></MudTd>
                        <MudTd><span class="text-muted">@(context.OldStatus ?? "-")</span></MudTd>
                        <MudTd><span class="fw-bold" style="color: #ea580c;">@(context.NewStatus ?? "-")</span></MudTd>
                        <MudTd>@context.Description</MudTd>
                        <MudTd><strong>@(context.ChangedByName ?? "النظام")</strong></MudTd>
                        <MudTd><MudChip T="string" Size="MudBlazor.Size.Small" Variant="MudBlazor.Variant.Outlined">@(context.ChangedByRole ?? "Warehouse")</MudChip></MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        }
    </DialogContent>
</MudDialog>

<!-- ════════════════════ COMPREHENSIVE A4 PRINT PREVIEW MODAL ════════════════════ -->
@if (_showPrintPreview)
{
    <div class="wh-print-overlay" @onclick="@(() => _showPrintPreview = false)">
        <div class="wh-print-dialog-card" @onclick:stopPropagation="true">
            <div class="wh-print-dialog-header no-print">
                <div class="d-flex align-center gap-2">
