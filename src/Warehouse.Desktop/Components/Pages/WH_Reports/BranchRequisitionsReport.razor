                    <MudText Typo="Typo.h6" Style="font-weight: 800; color: #0f172a;">معاينة وطباعة تقرير مقارنة وتحليل طلبيات الفروع</MudText>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning"
                               StartIcon="@Icons.Material.Filled.Print" OnClick="PrintReportSheet" Style="font-weight: 800; border-radius: 8px;">
                        طباعة الآن (A4)
                    </MudButton>
                    <MudButton Variant="MudBlazor.Variant.Outlined" Color="MudBlazor.Color.Success"
                               StartIcon="@Icons.Material.Filled.TableChart" OnClick="ExportToExcel" Style="font-weight: 700; border-radius: 8px;">
                        تصدير إكسيل (.xlsx)
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" OnClick="@(() => _showPrintPreview = false)" />
                </div>
            </div>

            <div class="wh-print-dialog-body">
                <div class="wh-printable-report-sheet wh-printable-sheet" dir="rtl">
                    <!-- Clean Header -->
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 8px; margin-bottom: 14px;">
                        <h2 style="margin: 0; color: #0f172a; font-weight: 900; font-size: 1.4rem;">تقرير مقارنة وتحليل طلبيات الفروع والمستودعات</h2>
                        <p style="margin: 4px 0 0 0; color: #64748b; font-size: 0.85rem;">
                            الفرع: @SelectedBranchName | المخزن: @SelectedWarehouseName | الحالة: @SelectedStatusName |
                            الفترة: من @(_fromDate?.ToString("yyyy/MM/dd") ?? "الكل") إلى @(_toDate?.ToString("yyyy/MM/dd") ?? "الكل") |
                            تاريخ الطباعة: @DateTime.Now.ToString("yyyy/MM/dd hh:mm tt")
                        </p>
                    </div>

                    <!-- Summary KPI Box in Print -->
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 16px;">
                        <div style="padding: 8px; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 6px; text-align: center;">
                            <span style="font-size: 0.75rem; color: #9a3412; display: block; font-weight: 700;">إجمالي الطلبيات</span>
                            <strong style="font-size: 1.1rem; color: #c2410c;">@_filteredRequisitions.Count طلبية</strong>
                        </div>
                        <div style="padding: 8px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px; text-align: center;">
                            <span style="font-size: 0.75rem; color: #166534; display: block; font-weight: 700;">الطلبيات المستلمة</span>
                            <strong style="font-size: 1.1rem; color: #15803d;">@_receivedOrdersCount طلبية</strong>
                        </div>
                        <div style="padding: 8px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 6px; text-align: center;">
                            <span style="font-size: 0.75rem; color: #1e40af; display: block; font-weight: 700;">قيد المراجعة / التجهيز</span>
                            <strong style="font-size: 1.1rem; color: #1d4ed8;">@_pendingOrdersCount طلبية</strong>
                        </div>
                        <div style="padding: 8px; background: #faf5ff; border: 1px solid #e9d5ff; border-radius: 6px; text-align: center;">
                            <span style="font-size: 0.75rem; color: #6b21a8; display: block; font-weight: 700;">نسبة الإنجاز بالكميات</span>
                            <strong style="font-size: 1.1rem; color: #7e22ce;">@($"{_overallFulfillmentRate:0.#}%")</strong>
                        </div>
                    </div>

                    <!-- Comparison Table in Print -->
                    <h3 style="font-size: 1rem; color: #0f172a; margin: 12px 0 6px 0; font-weight: 800;">1. جدول مقارنة الفروع</h3>
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.8rem; margin-bottom: 20px;">
                        <thead>
                            <tr style="background: #0f172a; color: white;">
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">#</th>
                                <th style="padding: 5px 8px; border: 1px solid #cbd5e1; text-align: right;">اسم الفرع</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">إجمالي الطلبيات</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">المستلمة</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">قيد التنفيذ</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">إجمالي المطلوب</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">إجمالي المورد</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">نسبة الإنجاز</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in _branchComparisons)
                            {
                                <tr style="background: @(b.Index % 2 == 0 ? "#f8fafc" : "#ffffff");">
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center;">@b.Index</td>
                                    <td style="padding: 5px 8px; border: 1px solid #e2e8f0; font-weight: 700;">@b.BranchName</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center; color: #ea580c; font-weight: 700;">@b.TotalOrders</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center; color: #16a34a; font-weight: 700;">@b.ReceivedOrders</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center; color: #2563eb; font-weight: 700;">@b.PendingOrders</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center; font-weight: 700;">@b.TotalRequestedQty.ToString("0.##")</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center; color: #16a34a; font-weight: 700;">@b.TotalDeliveredQty.ToString("0.##")</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center; font-weight: 800;">@($"{b.FulfillmentRate:0.#}%")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Detailed Requisitions in Print -->
                    <h3 style="font-size: 1rem; color: #0f172a; margin: 12px 0 6px 0; font-weight: 800;">2. سجل تفاصيل الطلبيات</h3>
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.78rem; margin-bottom: 24px;">
                        <thead>
                            <tr style="background: #1e293b; color: white;">
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">#</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: right;">رقم الطلب</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: right;">الفرع</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: right;">المستودع</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">تاريخ الطلب</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">عدد الأصناف</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">المطلوب</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">المستلم</th>
                                <th style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;">الحالة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int prIdx = 1; }
                            @foreach (var r in _filteredRequisitions)
                            {
                                <tr style="background: @(prIdx % 2 == 0 ? "#f8fafc" : "#ffffff");">
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center;">@prIdx</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; font-weight: 700; color: #ea580c;">@r.RequisitionNumber</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0;">@r.BranchName</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0;">@r.WarehouseName</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center;">@r.RequestDate.ToString("yyyy/MM/dd hh:mm tt")</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center;">@r.Lines.Count</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center; font-weight: 700;">@r.Lines.Sum(l => l.RequestedQuantity).ToString("0.##")</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center; color: #16a34a; font-weight: 700;">@r.Lines.Sum(l => l.ReceivedQuantity ?? l.ApprovedQuantity ?? 0).ToString("0.##")</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center; font-weight: 700;">@GetStatusLabel(r.Status)</td>
                                </tr>
                                prIdx++;
                            }
                        </tbody>
                    </table>

                    <!-- Signatures -->
                    <div style="display: flex; justify-content: space-around; margin-top: 24px; padding-top: 12px; border-top: 1px dashed #cbd5e1;">
                        <div style="text-align: center; width: 220px;">
                            <span style="font-weight: 700; color: #475569; display: block; margin-bottom: 24px;">مسؤول طلبيات الفروع</span>
                            <span style="border-top: 1px solid #94a3b8; display: block; padding-top: 4px;">التوقيع: .....................</span>
                        </div>
                        <div style="text-align: center; width: 220px;">
                            <span style="font-weight: 700; color: #475569; display: block; margin-bottom: 24px;">أمين المستودع العام</span>
                            <span style="border-top: 1px solid #94a3b8; display: block; padding-top: 4px;">التوقيع: .....................</span>
                        </div>
                        <div style="text-align: center; width: 220px;">
                            <span style="font-weight: 700; color: #475569; display: block; margin-bottom: 24px;">اعتماد مدير إدارة الإمداد</span>
                            <span style="border-top: 1px solid #94a3b8; display: block; padding-top: 4px;">التوقيع: .....................</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

