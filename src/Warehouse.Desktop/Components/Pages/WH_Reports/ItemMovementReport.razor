@page "/reports/item-movements"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using System.Net.Http.Json
@using System.Text
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject BlazorBase.Services.LocalizationService LocalizerService

<div class="wh-page-wrapper" dir="@(IsArabic ? "rtl" : "ltr")">
    <div class="wh-page-header d-flex justify-space-between align-center mb-4">
        <div>
            <MudText MudBlazor.Typo="Typo.h5" Class="wh-title">تقرير حركة صنف تفصيلي (Item Movement)</MudText>
            <MudText MudBlazor.Typo="Typo.body2" Color="MudBlazor.Color.Secondary">تتبع دقيق لكافة حركات الوارد والمنصرف والتحويلات والتسويات لصنف معين عبر المخازن</MudText>
        </div>
        @if (_movements.Any())
        {
            <div class="d-flex gap-2">
                <MudButton Variant="MudBlazor.Variant.Outlined" Color="MudBlazor.Color.Success"
                           StartIcon="@Icons.Material.Filled.TableChart" OnClick="ExportToExcel">
                    تصدير إكسيل
                </MudButton>
                <MudButton Variant="MudBlazor.Variant.Outlined" Color="MudBlazor.Color.Primary"
                           StartIcon="@Icons.Material.Filled.Description" OnClick="ExportToWord">
                    تصدير وورد
                </MudButton>
            </div>
        }
    </div>

    <MudCard Class="wh-card mb-4" Elevation="1">
        <MudCardContent>
            <MudGrid Spacing="3" Class="align-end">
                <MudItem xs="12" sm="4">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color:#475569;">الصنف المطلوب *</MudText>
                    <MudSelect T="int" @bind-Value="_selectedProductId" Variant="MudBlazor.Variant.Outlined"
                               Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" Placeholder="اختر الصنف">
                        @foreach (var p in _products)
                        {
                            <MudSelectItem Value="@p.Id">@p.NameAr (@p.SKU)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color:#475569;">المستودع (اختياري)</MudText>
                    <MudSelect T="int?" @bind-Value="_selectedWarehouseId" Variant="MudBlazor.Variant.Outlined"
                               Margin="Margin.Dense" Clearable="true" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="int?" Value="@((int?)null)">-- كل المستودعات --</MudSelectItem>
                        @foreach (var w in _warehouses)
                        {
                            <MudSelectItem Value="@((int?)w.Id)">@w.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color:#475569;">من تاريخ</MudText>
                    <MudDatePicker @bind-Date="_fromDate" Variant="MudBlazor.Variant.Outlined"
                                   Margin="Margin.Dense" DateFormat="yyyy/MM/dd"
                                   Culture="@(IsArabic ? new System.Globalization.CultureInfo("ar-EG") : new System.Globalization.CultureInfo("en-US"))" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color:#475569;">إلى تاريخ</MudText>
                    <MudDatePicker @bind-Date="_toDate" Variant="MudBlazor.Variant.Outlined"
                                   Margin="Margin.Dense" DateFormat="yyyy/MM/dd"
                                   Culture="@(IsArabic ? new System.Globalization.CultureInfo("ar-EG") : new System.Globalization.CultureInfo("en-US"))" />
                </MudItem>
                <MudItem xs="12" sm="1" Class="d-flex align-end pb-1">
                    <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning"
                               StartIcon="@Icons.Material.Filled.Search" OnClick="SearchMovements"
                               Style="height: 40px; border-radius: 8px; font-weight: 700; width: 100%;">عرض</MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    @if (_movements.Any())
    {
        <!-- KPI Summary Cards -->
        <div class="d-flex gap-4 mb-4 flex-wrap">
            <MudPaper Class="pa-4 flex-grow-1" Style="background:#ecfdf5; border:1px solid #10b981; border-radius:8px;">
                <MudText MudBlazor.Typo="Typo.caption" Style="color:#047857;">إجمالي الوارد (+)</MudText>
                <MudText MudBlazor.Typo="Typo.h6" Class="fw-bold" Style="color:#065f46;">+@TotalIn.ToString("N2")</MudText>
            </MudPaper>
            <MudPaper Class="pa-4 flex-grow-1" Style="background:#fef2f2; border:1px solid #ef4444; border-radius:8px;">
                <MudText MudBlazor.Typo="Typo.caption" Style="color:#b91c1c;">إجمالي المنصرف (-)</MudText>
                <MudText MudBlazor.Typo="Typo.h6" Class="fw-bold" Style="color:#991b1b;">-@TotalOut.ToString("N2")</MudText>
            </MudPaper>
            <MudPaper Class="pa-4 flex-grow-1" Style="background:#fff7ed; border:1px solid #ea580c; border-radius:8px;">
                <MudText MudBlazor.Typo="Typo.caption" Style="color:#c2410c;">صافي حركة الفترة</MudText>
                <MudText MudBlazor.Typo="Typo.h6" Class="fw-bold" Style="color:#9a3412;">@((TotalIn - TotalOut).ToString("N2"))</MudText>
            </MudPaper>
            <MudPaper Class="pa-4 flex-grow-1" Style="background:#f0f9ff; border:1px solid #0284c7; border-radius:8px;">
                <MudText MudBlazor.Typo="Typo.caption" Style="color:#0369a1;">الرصيد الختامي</MudText>
                <MudText MudBlazor.Typo="Typo.h6" Class="fw-bold" Style="color:#075985;">@FinalBalance.ToString("N2")</MudText>
            </MudPaper>
        </div>
    }

    <MudCard Class="wh-card">
        <MudCardContent>
            @if (_loading)
            {
                <MudProgressLinear Color="MudBlazor.Color.Primary" Indeterminate="true" />
            }
            else
            {
                <MudTable Items="_movements" Hover="true" Striped="true" Dense="true">
                    <HeaderContent>
                        <MudTh>التاريخ</MudTh>
                        <MudTh>نوع الحركة</MudTh>
                        <MudTh>المستند المرجعي</MudTh>
                        <MudTh>المستودع</MudTh>
                        <MudTh>وارد (+)</MudTh>
                        <MudTh>صادر (-)</MudTh>
                        <MudTh>الرصيد التراكمي</MudTh>
                        <MudTh>تكلفة الوحدة</MudTh>
                        <MudTh>إجمالي القيمة</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.MovementDate.ToString("yyyy/MM/dd HH:mm")</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="MudBlazor.Size.Small" Color="@GetMovementColor(context.MovementType)">
                                @GetMovementLabel(context.MovementType)
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            <span class="fw-bold">@context.ReferenceDocumentType</span> - @context.ReferenceDocumentNumber
                        </MudTd>
                        <MudTd>@context.WarehouseName</MudTd>
                        <MudTd Class="fw-bold text-success">
                            @(context.QuantityIn > 0 ? $"+{context.QuantityIn:N2}" : "-")
                        </MudTd>
                        <MudTd Class="fw-bold text-error">
                            @(context.QuantityOut > 0 ? $"-{context.QuantityOut:N2}" : "-")
                        </MudTd>
                        <MudTd Class="fw-bold">@context.RunningBalance.ToString("N2")</MudTd>
                        <MudTd>@context.UnitCost.ToString("N2") ج.م</MudTd>
                        <MudTd>@context.TotalCost.ToString("N2") ج.م</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText MudBlazor.Align="MudBlazor.Align.Center" Class="py-6" Color="MudBlazor.Color.Secondary">
                            @(_selectedProductId <= 0 ? "يرجى اختيار صنف لعرض سجل الحركات" : "لا توجد حركات مسجلة لهذا الصنف")
                        </MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudCardContent>
    </MudCard>
</div>

@code {
    private bool IsArabic => LocalizerService.GetCurrentLanguage() == "ar";
    private bool _loading;
    private int _selectedProductId;
    private int? _selectedWarehouseId;
    private DateTime? _fromDate = DateTime.Today.AddMonths(-1);
    private DateTime? _toDate = DateTime.Today;

    private List<ProductLookupDto> _products = new();
    private List<WarehouseLookupDto> _warehouses = new();
    private List<MovementRowDto> _movements = new();

    private decimal TotalIn => _movements.Sum(m => m.QuantityIn);
    private decimal TotalOut => _movements.Sum(m => m.QuantityOut);
    private decimal FinalBalance => _movements.LastOrDefault()?.RunningBalance ?? 0m;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
    }

    private async Task LoadLookups()
    {
        try
        {
            var pRes = await Http.GetFromJsonAsync<List<ProductLookupDto>>("api/warehouse/products");
            if (pRes != null) _products = pRes;

            var wRes = await Http.GetFromJsonAsync<List<WarehouseLookupDto>>("api/warehouse/warehouses");
            if (wRes != null) _warehouses = wRes;
        }
        catch { }
    }

    private async Task SearchMovements()
    {
        if (_selectedProductId <= 0)
        {
            Snackbar.Add("يرجى اختيار صنف أولاً", MudBlazor.Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            var url = $"api/warehouse/reports/item-movements?productId={_selectedProductId}";
            if (_selectedWarehouseId.HasValue) url += $"&warehouseId={_selectedWarehouseId.Value}";
            if (_fromDate.HasValue) url += $"&from={_fromDate.Value:yyyy-MM-dd}";
            if (_toDate.HasValue) url += $"&to={_toDate.Value:yyyy-MM-dd}";

            var res = await Http.GetFromJsonAsync<List<MovementRowDto>>(url);
            _movements = res ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء جلب حركات الصنف: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Color GetMovementColor(int movementType) => movementType switch
    {
        1 => MudBlazor.Color.Success,  // GoodsReceipt
        2 => MudBlazor.Color.Warning,  // BranchDispatch
        3 => MudBlazor.Color.Info,     // TransferIn
        4 => MudBlazor.Color.Primary,  // TransferOut
        5 => MudBlazor.Color.Dark,     // Adjustment
        _ => MudBlazor.Color.Default
    };

    private string GetMovementLabel(int movementType) => movementType switch
    {
        1 => "استلام مورد (GRN)",
        2 => "صرف لفرع",
        3 => "تحويل وارد",
        4 => "تحويل صادر",
        5 => "تسوية مخزنية",
        _ => "حركة مخزن"
    };

    private async Task ExportToExcel()
    {
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("التاريخ,نوع الحركة,المستند المرجعي,المستودع,وارد (+),صادر (-),الرصيد التراكمي,تكلفة الوحدة,إجمالي القيمة");
            foreach (var m in _movements)
            {
                sb.AppendLine($"\"{m.MovementDate:yyyy/MM/dd HH:mm}\",\"{GetMovementLabel(m.MovementType)}\",\"{m.ReferenceDocumentType} - {m.ReferenceDocumentNumber}\",\"{m.WarehouseName}\",{m.QuantityIn},{m.QuantityOut},{m.RunningBalance},{m.UnitCost},{m.TotalCost}");
            }

            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var prodName = _products.FirstOrDefault(p => p.Id == _selectedProductId)?.NameAr ?? "Item";
            await JS.InvokeVoidAsync("downloadBase64File", $"Item_Movements_{prodName}_{DateTime.Now:yyyyMMdd}.csv", "text/csv;charset=utf-8", base64);
            Snackbar.Add("تم تصدير ملف الإكسيل بنجاح", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"فشل التصدير: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task ExportToWord()
    {
        try
        {
            var prod = _products.FirstOrDefault(p => p.Id == _selectedProductId);
            var prodName = prod?.NameAr ?? "الصنف";
            var sb = new StringBuilder();
            sb.AppendLine("<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>");
            sb.AppendLine("<head><meta charset='utf-8'><title>تقرير حركة صنف</title>");
            sb.AppendLine("<style>body{font-family:Arial,sans-serif;direction:rtl;text-align:right;} table{width:100%;border-collapse:collapse;margin-top:15px;} th,td{border:1px solid #ccc;padding:8px;text-align:right;} th{background-color:#f2f2f2;}</style>");
            sb.AppendLine("</head><body>");
            sb.AppendLine($"<h2>تقرير حركة الصنف: {prodName} ({prod?.SKU})</h2>");
            sb.AppendLine($"<p>تاريخ استخراج التقرير: {DateTime.Now:yyyy/MM/dd HH:mm}</p>");
            sb.AppendLine($"<p>إجمالي الوارد: {TotalIn:N2} | إجمالي المنصرف: {TotalOut:N2} | الرصيد الختامي: {FinalBalance:N2}</p>");
            sb.AppendLine("<table>");
            sb.AppendLine("<thead><tr><th>التاريخ</th><th>نوع الحركة</th><th>المستند المرجعي</th><th>المستودع</th><th>وارد (+)</th><th>صادر (-)</th><th>الرصيد التراكمي</th><th>تكلفة الوحدة</th><th>إجمالي القيمة</th></tr></thead>");
            sb.AppendLine("<tbody>");
            foreach (var m in _movements)
            {
                sb.AppendLine($"<tr><td>{m.MovementDate:yyyy/MM/dd HH:mm}</td><td>{GetMovementLabel(m.MovementType)}</td><td>{m.ReferenceDocumentType} - {m.ReferenceDocumentNumber}</td><td>{m.WarehouseName}</td><td>{m.QuantityIn:N2}</td><td>{m.QuantityOut:N2}</td><td>{m.RunningBalance:N2}</td><td>{m.UnitCost:N2}</td><td>{m.TotalCost:N2}</td></tr>");
            }
            sb.AppendLine("</tbody></table></body></html>");

            var bytes = Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadBase64File", $"Item_Movements_{prodName}_{DateTime.Now:yyyyMMdd}.doc", "application/msword;charset=utf-8", base64);
            Snackbar.Add("تم تصدير ملف الوورد بنجاح", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"فشل التصدير: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    public record ProductLookupDto(int Id, string NameAr, string SKU);
    public record WarehouseLookupDto(int Id, string NameAr);
    public record MovementRowDto(
        DateTime MovementDate, int MovementType, decimal QuantityIn, decimal QuantityOut,
        decimal RunningBalance, decimal UnitCost, decimal TotalCost,
        string ReferenceDocumentType, string ReferenceDocumentNumber, string? WarehouseName);
}

