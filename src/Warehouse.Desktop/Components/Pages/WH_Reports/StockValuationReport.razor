    private async Task PrintReport()
    {
        try
        {
            await JS.InvokeVoidAsync("printReportElement", ".wh-printable-sheet");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء فتح الطباعة: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private void ExportExcel()
    {
        if (!_items.Any())
        {
            Snackbar.Add("لا توجد بيانات للتصدير", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            var itemsList = FilteredItems.Select(x => new
            {
                SKU = x.ProductCode,
                ProductName = x.ProductName,
                CategoryName = x.Category,
                WarehouseName = x.WarehouseName,
                CurrentStock = x.OnHandQty,
                UnitName = x.UnitName,
                AverageCost = x.AvgCostPrice,
                TotalValue = x.TotalValue
            }).Cast<dynamic>().ToList();

            var bytes = WarehouseExcelExportHelper.GenerateStockValuation(
                itemsList,
                _summary.TotalValue,
                _summary.TotalItems,
                _summary.AvgCostPrice,
                SelectedWarehouseName,
                SelectedCategoryName,
                DateTime.Today,
                _currency);

            var defaultFileName = $"تقييم_المخزون_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            var savedPath = PrintingService.SaveFile(bytes, defaultFileName, "Excel Files (*.xlsx)|*.xlsx", "حفظ تقرير تقييم المخزون", true);

            if (!string.IsNullOrEmpty(savedPath))
            {
                Snackbar.Add($"تم حفظ ملف الإكسيل بنجاح على جهازك في: {System.IO.Path.GetFileName(savedPath)}", MudBlazor.Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"فشل تصدير الإكسيل: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private class WarehouseLookup
    {
        public int Id { get; set; }
        public string? NameAr { get; set; }
        public string? NameEn { get; set; }
        public string? Name { get; set; }
        public string DisplayName => !string.IsNullOrWhiteSpace(NameAr) ? NameAr : (!string.IsNullOrWhiteSpace(Name) ? Name : (NameEn ?? $"مستودع {Id}"));
    }

    private class CategoryLookup
    {
        public int Id { get; set; }
        public string? ArabicName { get; set; }
        public string? EnglishName { get; set; }
        public string? Name { get; set; }
        public string DisplayName => !string.IsNullOrWhiteSpace(ArabicName) ? ArabicName : (!string.IsNullOrWhiteSpace(Name) ? Name : (EnglishName ?? $"فئة {Id}"));
    }

    public class StockValuationItemDto
    {
        public int ProductId { get; set; }
        public string? ProductCode { get; set; }
        public string? ProductName { get; set; }
        public string? Category { get; set; }
        public string? WarehouseName { get; set; }
        public decimal OnHandQty { get; set; }
        public string? UnitName { get; set; }
        public decimal AvgCostPrice { get; set; }
        public decimal TotalValue { get; set; }
    }

    public class StockValuationSummary
    {
        public decimal TotalValue { get; set; }
        public int TotalItems { get; set; }
        public decimal TotalQuantity { get; set; }
        public decimal AvgCapitalPerItem => TotalItems > 0 ? TotalValue / TotalItems : 0;
        public decimal AvgCostPrice { get; set; }
    }

    public class PagedReportResult
    {
        public List<StockValuationItemDto> Items { get; set; } = new();
        public int TotalCount { get; set; }
    }
