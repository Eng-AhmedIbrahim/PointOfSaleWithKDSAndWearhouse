@page "/reports/stock-valuation"
@attribute [Authorize]
@using MudBlazor
@using System.Net.Http.Json
@using System.Text.Json
@using System.Globalization
@using BlazorBase.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject LocalizationService LocalizerService

<div class="wh-page-wrapper" dir="@(IsArabic ? "rtl" : "ltr")">
    <div class="wh-page-header d-flex justify-space-between align-center mb-4">
        <MudText MudBlazor.Typo="Typo.h5" Style="font-weight: 800;">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="me-2" />
            تقرير تقييم المخزون (Stock Valuation)
        </MudText>
        <div class="d-flex gap-2">
            <MudButton Variant="MudBlazor.Variant.Outlined" StartIcon="@Icons.Material.Filled.Print"
                       OnClick="@(() => Snackbar.Add("جارٍ تجهيز الطباعة...", MudBlazor.Severity.Info))">طباعة</MudButton>
            <MudButton Variant="MudBlazor.Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                       OnClick="@(() => Snackbar.Add("جارٍ تجهيز التصدير...", MudBlazor.Severity.Info))">تصدير</MudButton>
        </div>
    </div>

    <!-- Filters -->
    <MudPaper Class="wh-card pa-4 mb-4" Elevation="1">
        <MudGrid Spacing="3" Class="align-end">
            <MudItem xs="12" sm="4">
                <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color: #475569;">المخزن</MudText>
                <MudSelect T="int?" @bind-Value="_filterWarehouseId"
                           Clearable="true" Variant="MudBlazor.Variant.Outlined"
                           Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="int?" Value="@((int?)null)">-- كل المخازن --</MudSelectItem>
                    @foreach (var w in _warehouses)
                    {
                        <MudSelectItem T="int?" Value="@((int?)w.Id)">@w.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color: #475569;">الفئة</MudText>
                <MudSelect T="int?" @bind-Value="_filterCategoryId"
                           Clearable="true" Variant="MudBlazor.Variant.Outlined"
                           Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="int?" Value="@((int?)null)">-- كل الفئات --</MudSelectItem>
                    @foreach (var c in _categories)
                    {
                        <MudSelectItem T="int?" Value="@((int?)c.Id)">@c.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color: #475569;">بتاريخ</MudText>
                <MudDatePicker @bind-Date="_filterAsOfDate"
                               Variant="MudBlazor.Variant.Outlined" DateFormat="yyyy-MM-dd"
                               Margin="Margin.Dense"
                               Culture="@(IsArabic ? new CultureInfo("ar-EG") : new CultureInfo("en-US"))" />
            </MudItem>
            <MudItem xs="12" sm="1" Class="d-flex align-end pb-1">
                <MudButton Color="MudBlazor.Color.Warning" Variant="MudBlazor.Variant.Filled" Class="wh-btn-primary"
                           StartIcon="@Icons.Material.Filled.Search" OnClick="LoadReport"
                           Style="height: 40px; border-radius: 8px; font-weight: 700; width: 100%;">
                    بحث
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Summary Cards -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Class="wh-card pa-4 text-center" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Large" />
                <MudText MudBlazor.Typo="Typo.caption" Class="d-block">إجمالي القيمة</MudText>
                <MudText MudBlazor.Typo="Typo.h5" Color="MudBlazor.Color.Warning"><b>@_summary.TotalValue.ToString("N2")</b></MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="wh-card pa-4 text-center" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" />
                <MudText MudBlazor.Typo="Typo.caption" Class="d-block">عدد الأصناف</MudText>
                <MudText MudBlazor.Typo="Typo.h5" Color="MudBlazor.Color.Primary"><b>@_summary.TotalItems</b></MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="wh-card pa-4 text-center" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.Calculate" Color="MudBlazor.Color.Success" Size="MudBlazor.Size.Large" />
                <MudText MudBlazor.Typo="Typo.caption" Class="d-block">متوسط التكلفة</MudText>
                <MudText MudBlazor.Typo="Typo.h5" Color="MudBlazor.Color.Success"><b>@_summary.AvgCostPrice.ToString("N2")</b></MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Table -->
    <MudPaper Class="wh-card" Elevation="1">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="MudBlazor.Color.Warning" />
        }
        <MudTable Items="_items.OrderByDescending(x => x.TotalValue)" Dense="true" Striped="true" Hover="true"
                  Loading="_loading" LoadingProgressColor="MudBlazor.Color.Warning" FixedHeader="true" Height="450px">
            <HeaderContent>
                <MudTh>كود الصنف</MudTh>
                <MudTh>اسم الصنف</MudTh>
                <MudTh>الفئة</MudTh>
                <MudTh>المخزن</MudTh>
                <MudTh>الكمية المتاحة</MudTh>
                <MudTh>الوحدة</MudTh>
                <MudTh>متوسط التكلفة</MudTh>
                <MudTh>إجمالي القيمة</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="كود الصنف">
                    <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Default" Variant="MudBlazor.Variant.Outlined">
                        @context.ProductCode
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="اسم الصنف"><b>@context.ProductName</b></MudTd>
                <MudTd DataLabel="الفئة">@context.Category</MudTd>
                <MudTd DataLabel="المخزن">@context.WarehouseName</MudTd>
                <MudTd DataLabel="الكمية المتاحة">
                    <span class="font-weight-bold" style="color: @(context.OnHandQty > 0 ? "#16a34a" : "#dc2626");">
                        @context.OnHandQty.ToString("N2")
                    </span>
                </MudTd>
                <MudTd DataLabel="الوحدة">@context.UnitName</MudTd>
                <MudTd DataLabel="متوسط التكلفة">@context.AvgCostPrice.ToString("N2")</MudTd>
                <MudTd DataLabel="إجمالي القيمة">
                    <b style="color: #ea580c;">@context.TotalValue.ToString("N2")</b>
                </MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd colspan="7"><b>الإجمالي الكلي</b></MudTd>
                <MudTd><b style="color: #ea580c;">@_summary.TotalValue.ToString("N2")</b></MudTd>
            </FooterContent>
            <NoRecordsContent>
                <MudText Class="pa-6 text-center text-muted">لا توجد بيانات مخزون مطابقة للبحث</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</div>

@code {
    private bool IsArabic => LocalizerService.GetCurrentLanguage() == "ar";
    private bool _loading = true;

    private int? _filterWarehouseId;
    private int? _filterCategoryId;
    private DateTime? _filterAsOfDate = DateTime.Today;

    private List<WarehouseLookup> _warehouses = new();
    private List<CategoryLookup> _categories = new();
    private List<StockValuationItemDto> _items = new();
    private StockValuationSummary _summary = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadReport();
    }

    private async Task LoadLookups()
    {
        try
        {
            var whs = await Http.GetFromJsonAsync<List<WarehouseLookup>>("api/warehouse/warehouses");
            _warehouses = whs ?? new();
        }
        catch
        {
            try { _warehouses = await Http.GetFromJsonAsync<List<WarehouseLookup>>("api/warehouses") ?? new(); }
            catch { }
        }

        try
        {
            var cats = await Http.GetFromJsonAsync<List<CategoryLookup>>("api/categories");
            _categories = cats ?? new();
        }
        catch
        {
            try { _categories = await Http.GetFromJsonAsync<List<CategoryLookup>>("api/Category/GetAllCategories") ?? new(); }
            catch { }
        }
    }

    private async Task LoadReport()
    {
        _loading = true;
        try
        {
            var query = new List<string>();
            if (_filterWarehouseId.HasValue) query.Add($"warehouseId={_filterWarehouseId}");

            var url = "api/warehousereports/stock-valuation" + (query.Any() ? "?" + string.Join("&", query) : "");

            HttpResponseMessage response;
            try
            {
                response = await Http.GetAsync(url);
            }
            catch
            {
                response = await Http.GetAsync("api/warehouse/reports/stock-valuation" + (query.Any() ? "?" + string.Join("&", query) : ""));
            }

            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

                if (content.TrimStart().StartsWith("["))
                {
                    _items = JsonSerializer.Deserialize<List<StockValuationItemDto>>(content, options) ?? new();
                }
                else
                {
                    var paged = JsonSerializer.Deserialize<PagedReportResult>(content, options);
                    _items = paged?.Items ?? new();
                }

                _summary = new StockValuationSummary
                {
                    TotalValue = _items.Sum(x => x.TotalValue),
                    TotalItems = _items.Count,
                    AvgCostPrice = _items.Any() ? _items.Average(x => x.AvgCostPrice) : 0
                };
            }
            else
            {
                Snackbar.Add("تعذر تحميل تقرير تقييم المخزون", MudBlazor.Severity.Warning);
            }
        }
        catch
        {
            Snackbar.Add("حدث خطأ أثناء تحميل تقرير تقييم المخزون", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private class WarehouseLookup
    {
        public int Id { get; set; }
        public string? NameAr { get; set; }
        public string? NameEn { get; set; }
        public string? Name { get; set; }
        public string DisplayName => !string.IsNullOrWhiteSpace(NameAr) ? NameAr : (!string.IsNullOrWhiteSpace(Name) ? Name : (NameEn ?? $"مستودع {Id}"));
    }

    private class CategoryLookup
    {
        public int Id { get; set; }
        public string? ArabicName { get; set; }
        public string? EnglishName { get; set; }
        public string? Name { get; set; }
        public string DisplayName => !string.IsNullOrWhiteSpace(ArabicName) ? ArabicName : (!string.IsNullOrWhiteSpace(Name) ? Name : (EnglishName ?? $"فئة {Id}"));
    }

    public class StockValuationItemDto
    {
        public string ProductCode { get; set; } = "";
        public string ProductName { get; set; } = "";
        public string Category { get; set; } = "";
        public string WarehouseName { get; set; } = "";
        public decimal OnHandQty { get; set; }
        public string UnitName { get; set; } = "";
        public decimal AvgCostPrice { get; set; }
        public decimal TotalValue { get; set; }
    }

    private class PagedReportResult
    {
        public decimal TotalValue { get; set; }
        public int ItemCount { get; set; }
        public List<StockValuationItemDto>? Items { get; set; }
    }

    private class StockValuationSummary
    {
        public decimal TotalValue { get; set; }
        public int TotalItems { get; set; }
        public decimal AvgCostPrice { get; set; }
    }
}
