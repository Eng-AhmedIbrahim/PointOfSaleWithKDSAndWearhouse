@page "/reports/reorder-alerts"
@attribute [Authorize]
@using MudBlazor
@using System.Net.Http.Json
@using BlazorBase.Services
@using Warehouse.Desktop.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject LocalizationService LocalizerService
@inject IDesktopPrintingService PrintingService
@inject WarehouseCurrencyService CurrencyService
@inject IJSRuntime JS

<div class="wh-page-wrapper" dir="@(IsArabic ? "rtl" : "ltr")">
    <!-- Header -->
    <div class="wh-page-header d-flex justify-space-between align-center mb-4 flex-wrap gap-2">
        <div>
            <MudText MudBlazor.Typo="Typo.h5" Style="font-weight: 800; color: #0f172a;">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" Color="MudBlazor.Color.Error" />
                @(IsArabic ? "تقرير نواقص المخزون وتنبيهات إعادة الطلب" : "Low Stock & Reorder Alerts")
            </MudText>
            <MudText MudBlazor.Typo="Typo.body2" Color="MudBlazor.Color.Secondary">
                @(IsArabic ? "حصر الأصناف النافدة والحرجة التي وصلت لحد إعادة الطلب مع مقترحات الكميات المطلوبة" : "Track out of stock and critical items reaching reorder points")
            </MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Color="MudBlazor.Color.Warning" Variant="MudBlazor.Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Visibility" OnClick="OpenPrintPreview"
                       Style="font-weight: 700; border-radius: 8px;">
                معاينة وطباعة
            </MudButton>
            <MudButton Color="MudBlazor.Color.Success" Variant="MudBlazor.Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.TableChart" OnClick="ExportExcel"
                       Style="font-weight: 700; border-radius: 8px;">
                تصدير إكسيل (.xlsx)
            </MudButton>
        </div>
    </div>

    <!-- Filters -->
    <MudPaper Class="wh-card pa-4 mb-4" Elevation="1" Style="border-radius: 12px; border: 1px solid #e2e8f0;">
        <MudGrid Spacing="3" Class="align-end">
            <MudItem xs="12" sm="5">
                <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color:#475569;">المخزن</MudText>
                <MudSelect T="int?" @bind-Value="_filterWarehouseId"
                           Clearable="true" Variant="MudBlazor.Variant.Outlined"
                           Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="int?" Value="@((int?)null)">-- كل المخازن --</MudSelectItem>
                    @foreach (var w in _warehouses)
                    {
                        <MudSelectItem T="int?" Value="@((int?)w.Id)">@w.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color:#475569;">مستوى الإلحاح</MudText>
                <MudSelect T="string" @bind-Value="_filterUrgency" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("All")">الكل (نافد + حرج + منخفض)</MudSelectItem>
                    <MudSelectItem Value="@("OutOfStock")">نافد تماماً (صفر أو أقل)</MudSelectItem>
                    <MudSelectItem Value="@("Critical")">حرج (أقل من 50% من حد الطلب)</MudSelectItem>
                    <MudSelectItem Value="@("Warning")">أقل من حد إعادة الطلب</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3" Class="d-flex align-end pb-1 gap-2">
                <MudButton Color="MudBlazor.Color.Warning" Variant="MudBlazor.Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Search" OnClick="LoadReport"
                           Style="height: 40px; border-radius: 8px; font-weight: 700; flex: 1;">
                    بحث
                </MudButton>
                <MudButton Color="MudBlazor.Color.Default" Variant="MudBlazor.Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetFilters"
                           Style="height: 40px; border-radius: 8px;">
                    إعادة ضبط
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- KPI Summary Cards -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Class="wh-card pa-4 text-center" Elevation="1" Style="border-radius: 12px; border-right: 5px solid #dc2626; background: #fef2f2;">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText MudBlazor.Typo="Typo.caption" Style="color: #991b1b; font-weight: 700;">أصناف نافدة تماماً</MudText>
                        <MudText MudBlazor.Typo="Typo.h5" Style="color: #dc2626; font-weight: 900;">@OutOfStockCount <small style="font-size: 0.6em;">صنف</small></MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Dangerous" Style="font-size: 42px; color: #dc2626; opacity: 0.8;" />
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="wh-card pa-4 text-center" Elevation="1" Style="border-radius: 12px; border-right: 5px solid #ea580c; background: #fff7ed;">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText MudBlazor.Typo="Typo.caption" Style="color: #9a3412; font-weight: 700;">مستوى حرج جداً</MudText>
                        <MudText MudBlazor.Typo="Typo.h5" Style="color: #c2410c; font-weight: 900;">@CriticalCount <small style="font-size: 0.6em;">صنف</small></MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.PriorityHigh" Style="font-size: 42px; color: #ea580c; opacity: 0.8;" />
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="wh-card pa-4 text-center" Elevation="1" Style="border-radius: 12px; border-right: 5px solid #eab308; background: #fefce8;">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText MudBlazor.Typo="Typo.caption" Style="color: #854d0e; font-weight: 700;">تحت حد إعادة الطلب</MudText>
                        <MudText MudBlazor.Typo="Typo.h5" Style="color: #ca8a04; font-weight: 900;">@WarningCount <small style="font-size: 0.6em;">صنف</small></MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.NotificationImportant" Style="font-size: 42px; color: #eab308; opacity: 0.8;" />
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- CHARTS SECTION -->
    @if (_items.Any())
    {
        <MudGrid Spacing="3" Class="mb-4">
            <!-- 1. Urgency Donut -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="1" Style="border-radius: 12px; border: 1px solid #e2e8f0; height: 100%;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="MudBlazor.Color.Error" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 800;">تصنيف مستوى إلحاح النواقص</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="d-flex flex-column align-center justify-center py-2">
                        @if (_chartData.Any(v => v > 0))
                        {
                            <MudChart ChartType="ChartType.Donut" InputData="@_chartData" InputLabels="@_chartLabels"
                                      Width="240px" Height="230px" />
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- 2. Highest Shortage Items -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="1" Style="border-radius: 12px; border: 1px solid #e2e8f0; height: 100%;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="MudBlazor.Color.Warning" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 800;">أعلى كميات عجز مطلوبة للتوريد</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="py-2">
                        @if (_shortageChartSeries.Any())
                        {
                            <MudChart ChartType="ChartType.Bar" ChartSeries="@_shortageChartSeries" XAxisLabels="@_shortageXLabels"
                                      Width="100%" Height="230px" />
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    <!-- Table -->
    <MudPaper Class="wh-card" Elevation="1" Style="border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0;">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="MudBlazor.Color.Warning" />
        }
        <MudTable Items="_items" Dense="true" Hover="true" Loading="_loading"
                  LoadingProgressColor="MudBlazor.Color.Warning"
                  FixedHeader="true" Height="480px">
            <HeaderContent>
                <MudTh>كود الصنف</MudTh>
                <MudTh>اسم الصنف</MudTh>
                <MudTh>المخزن</MudTh>
                <MudTh Style="text-align: center;">الكمية الحالية</MudTh>
                <MudTh Style="text-align: center;">حد إعادة الطلب</MudTh>
                <MudTh Style="text-align: center;">العجز المطلوب</MudTh>
                <MudTh>الوحدة</MudTh>
                <MudTh Style="text-align: center;">الكمية المقترحة</MudTh>
                <MudTh>آخر مورد</MudTh>
                <MudTh Style="text-align: left;">آخر سعر شراء</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{
                    bool isCritical = context.CurrentQty <= 0;
                    bool isWarning = !isCritical && context.CurrentQty < context.ReorderLevel;
                    string rowBg = isCritical ? "#fef2f2" : (isWarning ? "#fffbeb" : "#ffffff");
                }
                <tr style="background-color: @rowBg;">
                    <MudTd DataLabel="كود الصنف">
                        <MudChip T="string" Size="MudBlazor.Size.Small" Variant="MudBlazor.Variant.Outlined" Style="font-weight: 700;">
                            @context.ProductCode
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="اسم الصنف">
                        <span style="font-weight: 700; color: @(isCritical ? "#dc2626" : "#0f172a");">
                            @context.ProductName
                        </span>
                    </MudTd>
                    <MudTd DataLabel="المخزن">@context.WarehouseName</MudTd>
                    <MudTd DataLabel="الكمية الحالية" Style="text-align: center;">
                        <b style="color: @(context.CurrentQty <= 0 ? "#dc2626" : "#ea580c");">@context.CurrentQty.ToString("N2")</b>
                    </MudTd>
                    <MudTd DataLabel="حد إعادة الطلب" Style="text-align: center;">@context.ReorderLevel.ToString("N2")</MudTd>
                    <MudTd DataLabel="العجز المطلوب" Style="text-align: center;">
                        <span style="color: #dc2626; font-weight: 800;">@context.Shortage.ToString("N2")</span>
                    </MudTd>
                    <MudTd DataLabel="الوحدة">@context.UnitName</MudTd>
                    <MudTd DataLabel="الكمية المقترحة" Style="text-align: center; font-weight: 800; color: #16a34a;">
                        @context.SuggestedOrderQty.ToString("N2")
                    </MudTd>
                    <MudTd DataLabel="آخر مورد">@(string.IsNullOrEmpty(context.LastSupplierName) ? "-" : context.LastSupplierName)</MudTd>
                    <MudTd DataLabel="آخر سعر شراء" Style="text-align: left;">@context.LastPurchasePrice.ToString("N2") @_currency</MudTd>
                </tr>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-6 text-center text-muted">ممتاز! لا توجد نواقص في المخزون حالياً</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</div>

<!-- ════════════════════ PRINT PREVIEW MODAL OVERLAY ════════════════════ -->
@if (_showPrintPreview)
{
    <div class="wh-print-overlay" @onclick="@(() => _showPrintPreview = false)">
        <div class="wh-print-dialog-card" @onclick:stopPropagation="true">
            <div class="wh-print-dialog-header no-print">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="MudBlazor.Color.Error" />
                    <MudText Typo="Typo.h6" Style="font-weight: 800; color: #0f172a;">معاينة وطباعة تقرير نواقص المخزون</MudText>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning"
                               StartIcon="@Icons.Material.Filled.Print" OnClick="PrintReport" Style="font-weight: 800; border-radius: 8px;">
                        طباعة الآن
                    </MudButton>
                    <MudButton Variant="MudBlazor.Variant.Outlined" Color="MudBlazor.Color.Success"
                               StartIcon="@Icons.Material.Filled.TableChart" OnClick="ExportExcel" Style="font-weight: 700; border-radius: 8px;">
                        تصدير إكسيل (.xlsx)
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" OnClick="@(() => _showPrintPreview = false)" />
                </div>
            </div>

            <div class="wh-print-dialog-body">
                <div class="wh-printable-sheet" dir="rtl">
                    <!-- Clean Header (Report Title Only) -->
                    <div style="text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 8px; margin-bottom: 14px;">
                        <h2 style="margin: 0; color: #0f172a; font-weight: 900; font-size: 1.4rem;">تقرير نواقص المخزون وتنبيهات إعادة الطلب</h2>
                        <p style="margin: 4px 0 0 0; color: #64748b; font-size: 0.85rem;">
                            المخزن: @SelectedWarehouseName | تاريخ: @DateTime.Now.ToString("yyyy/MM/dd hh:mm tt")
                        </p>
                    </div>

                    <!-- Summary Cards in Print -->
                    <div style="display: flex; gap: 12px; margin-bottom: 16px;">
                        <div style="flex: 1; padding: 10px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; text-align: center;">
                            <span style="font-size: 0.78rem; color: #991b1b; display: block; font-weight: 700;">نافد تماماً</span>
                            <strong style="font-size: 1.2rem; color: #dc2626;">@OutOfStockCount صنف</strong>
                        </div>
                        <div style="flex: 1; padding: 10px; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 8px; text-align: center;">
                            <span style="font-size: 0.78rem; color: #9a3412; display: block; font-weight: 700;">مستوى حرج جداً</span>
                            <strong style="font-size: 1.2rem; color: #c2410c;">@CriticalCount صنف</strong>
                        </div>
                        <div style="flex: 1; padding: 10px; background: #fefce8; border: 1px solid #fde047; border-radius: 8px; text-align: center;">
                            <span style="font-size: 0.78rem; color: #854d0e; display: block; font-weight: 700;">تحت حد الطلب</span>
                            <strong style="font-size: 1.2rem; color: #ca8a04;">@WarningCount صنف</strong>
                        </div>
                    </div>

                    <!-- Table in Print -->
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-bottom: 24px;">
                        <thead>
                            <tr style="background: #0f172a; color: white;">
                                <th style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: center;">#</th>
                                <th style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: right;">كود الصنف</th>
                                <th style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: right;">اسم الصنف</th>
                                <th style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: right;">المستودع</th>
                                <th style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: center;">الرصيد الحالي</th>
                                <th style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: center;">حد الطلب</th>
                                <th style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: center;">العجز</th>
                                <th style="padding: 6px 8px; border: 1px solid #cbd5e1; text-align: center;">المقترح طلبه</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int lIdx = 1; }
                            @foreach (var item in _items)
                            {
                                <tr style="background: @(item.CurrentQty <= 0 ? "#fef2f2" : (lIdx % 2 == 0 ? "#f8fafc" : "#ffffff"));">
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center;">@lIdx</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0;">@item.ProductCode</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; font-weight: 700;">@item.ProductName</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0;">@item.WarehouseName</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center; font-weight: 700; color: @(item.CurrentQty <= 0 ? "#dc2626" : "#ea580c");">@item.CurrentQty.ToString("N2")</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center;">@item.ReorderLevel.ToString("N2")</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center; color: #dc2626; font-weight: 800;">@item.Shortage.ToString("N2")</td>
                                    <td style="padding: 5px 6px; border: 1px solid #e2e8f0; text-align: center; font-weight: 800; color: #16a34a;">@item.SuggestedOrderQty.ToString("N2") @item.UnitName</td>
                                </tr>
                                lIdx++;
                            }
                        </tbody>
                    </table>

                    <!-- Signatures -->
                    <div style="display: flex; justify-content: space-around; margin-top: 24px; padding-top: 12px; border-top: 1px dashed #cbd5e1;">
                        <div style="text-align: center; width: 220px;">
                            <span style="font-weight: 700; color: #475569; display: block; margin-bottom: 24px;">أمين المستودع</span>
                            <span style="border-top: 1px solid #94a3b8; display: block; padding-top: 4px;">التوقيع: .....................</span>
                        </div>
                        <div style="text-align: center; width: 220px;">
                            <span style="font-weight: 700; color: #475569; display: block; margin-bottom: 24px;">المسؤول / الاعتماد</span>
                            <span style="border-top: 1px solid #94a3b8; display: block; padding-top: 4px;">التوقيع: .....................</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsArabic => LocalizerService.GetCurrentLanguage() == "ar";
    private bool _loading = false;
    private bool _showPrintPreview = false;
    private string _currency = "ج.م";

    private int? _filterWarehouseId;
    private string _filterUrgency = "All";

    private List<WarehouseLookup> _warehouses = new();
    private List<LowStockItemDto> _items = new();

    // Chart Data
    private double[] _chartData = Array.Empty<double>();
    private string[] _chartLabels = Array.Empty<string>();
    private List<ChartSeries> _shortageChartSeries = new();
    private string[] _shortageXLabels = Array.Empty<string>();

    private int OutOfStockCount => _items.Count(x => x.CurrentQty <= 0);
    private int CriticalCount => _items.Count(x => x.CurrentQty > 0 && x.CurrentQty < (x.ReorderLevel * 0.5m));
    private int WarningCount => _items.Count(x => x.CurrentQty >= (x.ReorderLevel * 0.5m) && x.CurrentQty < x.ReorderLevel);

    private string SelectedWarehouseName =>
        _filterWarehouseId.HasValue
            ? (_warehouses.FirstOrDefault(w => w.Id == _filterWarehouseId)?.DisplayName ?? "مستودع محدد")
            : "كل المخازن";

    protected override async Task OnInitializedAsync()
    {
        try { _currency = await CurrencyService.GetCurrencySymbolAsync(); } catch { _currency = "ج.م"; }
        await LoadWarehouses();
        await LoadReport();
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var whs = await Http.GetFromJsonAsync<List<WarehouseLookup>>("api/warehouse/warehouses");
            _warehouses = whs ?? new();
        }
        catch
        {
            try { _warehouses = await Http.GetFromJsonAsync<List<WarehouseLookup>>("api/warehouses") ?? new(); } catch { }
        }
    }

    private void ResetFilters()
    {
        _filterWarehouseId = null;
        _filterUrgency = "All";
        _ = LoadReport();
    }

    private async Task LoadReport()
    {
        _loading = true;
        try
        {
            var query = new List<string>();
            if (_filterWarehouseId.HasValue) query.Add($"warehouseId={_filterWarehouseId}");
            if (!string.IsNullOrEmpty(_filterUrgency) && _filterUrgency != "All") query.Add($"urgency={_filterUrgency}");

            var url = "api/warehousereports/reorder-alerts" + (query.Any() ? "?" + string.Join("&", query) : "");

            HttpResponseMessage response;
            try { response = await Http.GetAsync(url); }
            catch { response = await Http.GetAsync("api/warehouse/reports/reorder-alerts" + (query.Any() ? "?" + string.Join("&", query) : "")); }

            if (response.IsSuccessStatusCode)
            {
                _items = await response.Content.ReadFromJsonAsync<List<LowStockItemDto>>() ?? new();
                BuildCharts();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في تحميل تقرير النواقص: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildCharts()
    {
        if (!_items.Any()) return;

        // 1. Urgency Donut
        _chartData = new double[] { (double)OutOfStockCount, (double)CriticalCount, (double)WarningCount };
        _chartLabels = new string[] { $"نافد تماماً ({OutOfStockCount})", $"حرج ({CriticalCount})", $"تحذير ({WarningCount})" };

        // 2. Top 5 shortages
        var top5 = _items.OrderByDescending(x => x.Shortage).Take(5).ToList();
        _shortageXLabels = top5.Select(x => x.ProductName.Length > 12 ? x.ProductName.Substring(0, 12) + ".." : x.ProductName).ToArray();
        _shortageChartSeries = new List<ChartSeries>
        {
            new ChartSeries { Name = "العجز المطلوب", Data = top5.Select(x => (double)x.Shortage).ToArray() }
        };
    }

    private void OpenPrintPreview()
    {
        if (!_items.Any())
        {
            Snackbar.Add("لا توجد أصناف للمعاينة والطباعة", MudBlazor.Severity.Warning);
            return;
        }
        _showPrintPreview = true;
    }

    private async Task PrintReport()
    {
        try
        {
            await JS.InvokeVoidAsync("printReportElement", ".wh-printable-sheet");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء الطباعة: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private void ExportExcel()
    {
        if (!_items.Any())
        {
            Snackbar.Add("لا توجد بيانات للتصدير", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            var itemsList = _items.Select(x => new
            {
                SKU = x.ProductCode,
                ProductName = x.ProductName,
                WarehouseName = x.WarehouseName,
                CurrentStock = x.CurrentQty,
                ReorderLevel = x.ReorderLevel,
                Shortage = x.Shortage,
                SuggestedOrderQty = x.SuggestedOrderQty,
                LastPrice = x.LastPurchasePrice,
                StatusAr = x.CurrentQty <= 0 ? "نافد تماماً" : "أقل من حد الطلب"
            }).Cast<dynamic>().ToList();

            var bytes = WarehouseExcelExportHelper.GenerateLowStock(itemsList, OutOfStockCount, CriticalCount, WarningCount, _currency);
            var defaultFileName = $"نواقص_المخزون_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            var savedPath = PrintingService.SaveFile(bytes, defaultFileName, "Excel Files (*.xlsx)|*.xlsx", "حفظ تقرير نواقص المخزون", true);

            if (!string.IsNullOrEmpty(savedPath))
            {
                Snackbar.Add($"تم حفظ ملف الإكسيل بنجاح على جهازك: {System.IO.Path.GetFileName(savedPath)}", MudBlazor.Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"فشل التصدير: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private class WarehouseLookup
    {
        public int Id { get; set; }
        public string? NameAr { get; set; }
        public string? NameEn { get; set; }
        public string? Name { get; set; }
        public string DisplayName => !string.IsNullOrWhiteSpace(NameAr) ? NameAr : (!string.IsNullOrWhiteSpace(Name) ? Name : (NameEn ?? $"مستودع {Id}"));
    }

