@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText MudBlazor.Typo="MudBlazor.Typo.h6"><MudIcon Icon="@Icons.Material.Rounded.Warehouse" Class="me-2"/>@(Warehouse?.Id > 0 ? "تعديل مستودع" : "مستودع جديد")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="Warehouse!.Code" Label="الكود" Variant="MudBlazor.Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="Warehouse!.NameAr" Label="الاسم بالعربي" Variant="MudBlazor.Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="Warehouse!.NameEn" Label="الاسم بالإنجليزي" Variant="MudBlazor.Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="Warehouse!.Type" Label="نوع المستودع" Variant="MudBlazor.Variant.Outlined" Required="true">
                    <MudSelectItem Value="1">رئيسي (Main)</MudSelectItem>
                    <MudSelectItem Value="2">فرعي (Branch)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Warehouse!.ManagerName" Label="مسؤول المستودع" Variant="MudBlazor.Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Warehouse!.Phone" Label="الهاتف" Variant="MudBlazor.Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudCheckBox @bind-Value="Warehouse!.IsActive" Label="نشط" Color="MudBlazor.Color.Warning" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="Warehouse!.Address" Label="العنوان" Variant="MudBlazor.Variant.Outlined" Lines="2" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="MudBlazor.Variant.Text">إلغاء</MudButton>
        <MudButton OnClick="Save" Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning" Disabled="_saving">
            @if (_saving) { <MudProgressCircular Indeterminate="true" Size="MudBlazor.Size.Small" Class="me-2" /> }
            حفظ
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public WarehouseModel? Warehouse { get; set; }
    private bool _saving;

    private async Task Save()
    {
        _saving = true;
        try
        {
            HttpResponseMessage res;
            if (Warehouse?.Id > 0)
                res = await Http.PutAsJsonAsync($"api/warehouse/warehouses/{Warehouse.Id}", Warehouse);
            else
                res = await Http.PostAsJsonAsync("api/warehouse/warehouses", Warehouse);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("تم الحفظ بنجاح", MudBlazor.Severity.Success);
                MudDialog?.Close(DialogResult.Ok(true));
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add(err, MudBlazor.Severity.Error);
            }
        }
        finally { _saving = false; }
    }

    private void Cancel() => MudDialog?.Cancel();
    public class WarehouseModel
    {
        public int Id { get; set; }
        public string Code { get; set; } = "";
        public string NameAr { get; set; } = "";
        public string? NameEn { get; set; }
        public string? Type { get; set; } = "Main";
        public string? Phone { get; set; }
        public string? ManagerName { get; set; }
        public string? Address { get; set; }
        public bool IsActive { get; set; } = true;
        public int? BranchId { get; set; }
    }

}
