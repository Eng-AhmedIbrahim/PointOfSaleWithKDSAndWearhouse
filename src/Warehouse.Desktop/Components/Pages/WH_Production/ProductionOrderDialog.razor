@using MudBlazor
@using POS.Contract.Dtos.InventoryDtos
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog dir="rtl" Style="max-width: 900px; width: 95vw; border-radius: 16px; overflow: hidden;">
    <TitleContent>
        <div class="d-flex align-center gap-3 pa-2 border-b">
            <div class="pa-2 rounded-xl" style="background: linear-gradient(135deg, #f97316, #ea580c); color: white;">
                <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Size="MudBlazor.Size.Medium" />
            </div>
            <div>
                <MudText Typo="MudBlazor.Typo.h6" Style="font-weight: 900; color: #1e293b;">
                    إنشاء أمر تشغيل وإنتاج جديد
                </MudText>
                <MudText Typo="MudBlazor.Typo.caption" Color="MudBlazor.Color.Secondary">
                    تحديد كمية الصنف المصنّع وفحص توفر الخامات في المخزن الرئيسي وصرفها آلياً
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_loadingInit)
        {
            <div class="d-flex justify-center pa-8">
                <MudProgressCircular Indeterminate="true" Color="MudBlazor.Color.Warning" />
            </div>
        }
        else
        {
            <MudGrid Spacing="2" Class="pt-2">
                <!-- Warehouse Selection -->
                <MudItem xs="12" md="6">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color: #475569;">المخزن *</MudText>
                    <MudSelect T="int" @bind-Value="_model.WarehouseId" @bind-Value:after="OnParamsChanged"
                               Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var wh in _warehouses)
                        {
                            <MudSelectItem Value="@wh.Id">@wh.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Produced Product Selection -->
                <MudItem xs="12" md="6">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color: #475569;">الصنف المُراد تصنيعه / إنتاجه *</MudText>
                    <MudSelect T="int" @bind-Value="_model.ProducedProductId" @bind-Value:after="OnProductSelected"
                               Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter"
                               Placeholder="-- اختر الصنف المصنّع --">
                        @foreach (var prod in _products)
                        {
                            <MudSelectItem Value="@prod.Id">@prod.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Target & Actual Qty -->
                <MudItem xs="12" sm="6" md="4">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color: #475569;">الكمية المستهدفة للإنتاج *</MudText>
                    <MudNumericField T="decimal" @bind-Value="_model.TargetQuantity" @bind-Value:after="OnParamsChanged"
                                     Format="N2" Min="0.01m" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense"
                                     HideSpinButtons="true"
                                     Adornment="Adornment.End" AdornmentText="@_selectedProductUnit" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color: #475569;">الكمية المنتجة الفعلية</MudText>
                    <MudNumericField T="decimal" @bind-Value="_model.ActualQuantityProduced"
                                     Format="N2" Min="0.01m" Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense"
                                     HideSpinButtons="true"
                                     Adornment="Adornment.End" AdornmentText="@_selectedProductUnit" />
                </MudItem>

                <MudItem xs="12" sm="12" md="4" Class="d-flex align-center pt-5">
                    <MudSwitch T="bool" @bind-Value="_model.AutoExecuteImmediately"
                               Label="تنفيذ فوري وصرف الخامات للمخزن" Color="MudBlazor.Color.Success" />
                </MudItem>

                <!-- Ingredients Calculation Table -->
                <MudItem xs="12">
                    <div class="d-flex justify-space-between align-center my-2">
                        <MudText Typo="MudBlazor.Typo.subtitle2" Style="font-weight: 800; color: #1e293b;">
                            <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="MudBlazor.Size.Small" Class="me-1" Style="vertical-align: middle;" />
                            الخامات المطلوبة للتشغيل (حسب ريسيبي التصنيع)
                        </MudText>
                        @if (_hasStockDeficit)
                        {
                            <MudChip T="string" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small" Variant="MudBlazor.Variant.Filled">
                                ⚠️ يوجد عجز في رصيد بعض الخامات بالمخزن
                            </MudChip>
                        }
                    </div>

                    @if (_loadingIngredients)
                    {
                        <div class="d-flex justify-center pa-4">
                            <MudProgressCircular Indeterminate="true" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Warning" />
                        </div>
                    }
                    else if (!_ingredients.Any())
                    {
                        <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="my-2">
                            @if (_model.ProducedProductId > 0)
                            {
                                <span>لم يتم تعريف ريسيبي/مكونات إنتاج لهذا الصنف بعد. يمكنك إضافة وصفة تصنيع له من شاشة "وصفات التصنيع (BOM)".</span>
                            }
                            else
                            {
                                <span>يرجى اختيار الصنف المصنّع أعلاه لعرض الخامات المطلوبة وفحص توافرها.</span>
                            }
                        </MudAlert>
                    }
                    else
                    {
                        <MudPaper Elevation="0" Style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
                            <MudTable Items="_ingredients" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh Style="font-weight: 800; background: #f8fafc;">الخامة المطلوبة</MudTh>
                                    <MudTh Style="font-weight: 800; background: #f8fafc;">الكمية المطلوبة للدفعة</MudTh>
                                    <MudTh Style="font-weight: 800; background: #f8fafc;">الرصيد المتاح بالمخزن</MudTh>
                                    <MudTh Style="font-weight: 800; background: #f8fafc;">حالة التوفر</MudTh>
                                    <MudTh Style="font-weight: 800; background: #f8fafc;">التكلفة التقديرية</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="الخامة">
                                        <span style="font-weight: 700; color: #1e293b;">@context.IngredientProductName</span>
                                    </MudTd>
                                    <MudTd DataLabel="الكمية المطلوبة">
                                        <span style="font-weight: 800; color: #0284c7;">@context.Quantity.ToString("N3")</span>
                                        <small style="color: #64748b;"> @context.UnitName</small>
                                    </MudTd>
                                    <MudTd DataLabel="الرصيد المتاح">
                                        <span style="font-weight: 800; color: @(context.CurrentStockAvailable < context.Quantity ? "#dc2626" : "#16a34a");">
                                            @context.CurrentStockAvailable.ToString("N3")
                                        </span>
                                        <small style="color: #64748b;"> @context.UnitName</small>
                                    </MudTd>
                                    <MudTd DataLabel="الحالة">
                                        @if (context.CurrentStockAvailable >= context.Quantity)
                                        {
                                            <span class="px-2 py-0 rounded" style="background: #dcfce7; color: #15803d; font-weight: 700; font-size: 0.75rem;">
                                                متوفر بالكامل
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0 rounded" style="background: #fee2e2; color: #b91c1c; font-weight: 800; font-size: 0.75rem;">
                                                عجز (@((context.Quantity - context.CurrentStockAvailable).ToString("N2")) @context.UnitName)
                                            </span>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="التكلفة">
                                        <span style="font-weight: 700; color: #b45309;">@context.EstimatedCost.ToString("N2") ج.م</span>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>

                            <div class="pa-3 d-flex justify-space-between align-center" style="background: #f8fafc; border-top: 1px solid #e2e8f0;">
                                <span style="font-weight: 800; color: #475569;">إجمالي تكلفة الخامات المقدرة للتشغيل:</span>
                                <span style="font-weight: 900; color: #ea580c; font-size: 1.1rem;">
                                    @_ingredients.Sum(i => i.EstimatedCost).ToString("N2") ج.م
                                </span>
                            </div>
                        </MudPaper>
                    }
                </MudItem>

                <!-- Notes -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes" Lines="2"
                                  Placeholder="ملاحظات أمر الإنتاج / اسم الشيف / رقم الـ Batch..."
                                  Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <div class="d-flex gap-2 pa-2 w-100 justify-space-between align-center" dir="rtl">
            <div>
                @if (_hasStockDeficit)
                {
                    <span style="font-size: 0.8rem; color: #dc2626; font-weight: 700;">
                        تنبيه: يمكنك الحفظ رغم وجود عجز وسيتم تسجيل رصيد بالسالب لحين توريد الخامات.
                    </span>
                }
            </div>
            <div class="d-flex gap-2">
                <MudButton OnClick="Cancel" Variant="MudBlazor.Variant.Outlined">إلغاء</MudButton>
                <MudButton OnClick="Submit" Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning"
                           Disabled="_isSaving || _model.WarehouseId <= 0 || _model.ProducedProductId <= 0 || _model.TargetQuantity <= 0"
                           Style="font-weight: 800; min-width: 140px; background: linear-gradient(135deg, #f97316, #ea580c); color: white;">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="me-2" />
                    }
                    @(_model.AutoExecuteImmediately ? "بدء وتنفيذ الإنتاج" : "حفظ أمر التشغيل")
                </MudButton>
            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private bool _loadingInit = true;
    private bool _loadingIngredients = false;
    private bool _isSaving = false;
    private bool _hasStockDeficit => _ingredients.Any(i => i.CurrentStockAvailable < i.Quantity);

    private CreateProductionOrderRequest _model = new() { TargetQuantity = 10, ActualQuantityProduced = 10, AutoExecuteImmediately = true };
    private string _selectedProductUnit = "";

    private List<WarehouseLookupDto> _warehouses = new();
    private List<ProductLookupDto> _products = new();
    private List<ProductionRecipeIngredientDto> _ingredients = new();

    private class WarehouseLookupDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private class ProductLookupDto
    {
        public int Id { get; set; }
        public string? SKU { get; set; }
        public string NameAr { get; set; } = string.Empty;
        public string? UnitName { get; set; }
        public string DisplayName => !string.IsNullOrEmpty(SKU) ? $"{NameAr} ({SKU})" : NameAr;
    }

    protected override async Task OnInitializedAsync()
    {
        _loadingInit = true;
        try
        {
            // 1. Load Warehouses
            var whRes = await Http.GetFromJsonAsync<List<WarehouseLookupDto>>("api/warehouses");
            _warehouses = whRes ?? new();
            if (_warehouses.Any())
                _model.WarehouseId = _warehouses.First().Id;

            // 2. Load Products
            var prodRes = await Http.GetFromJsonAsync<List<ProductLookupDto>>("api/warehouse/products?activeOnly=true");
            _products = prodRes ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء تهيئة البيانات: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingInit = false;
        }
    }

    private async Task OnProductSelected()
    {
        var prod = _products.FirstOrDefault(p => p.Id == _model.ProducedProductId);
        _selectedProductUnit = prod?.UnitName ?? "وحدة";
        _model.ActualQuantityProduced = _model.TargetQuantity;
        await OnParamsChanged();
    }

    private async Task OnParamsChanged()
    {
        if (_model.WarehouseId <= 0 || _model.ProducedProductId <= 0 || _model.TargetQuantity <= 0)
        {
            _ingredients.Clear();
            return;
        }

        _loadingIngredients = true;
        try
        {
            var res = await Http.GetFromJsonAsync<List<ProductionRecipeIngredientDto>>(
                $"api/warehouse/production/calculate-ingredients?warehouseId={_model.WarehouseId}&productId={_model.ProducedProductId}&targetQty={_model.TargetQuantity}");
            _ingredients = res ?? new();
        }
        catch
        {
            _ingredients.Clear();
        }
        finally
        {
            _loadingIngredients = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        _isSaving = true;
        try
        {
            _model.Lines = _ingredients.Select(i => new ProductionOrderLineDto
            {
                IngredientProductId = i.IngredientProductId,
                PlannedQuantity = i.Quantity,
                ActualQuantityConsumed = i.Quantity,
                UnitCost = i.Quantity > 0 ? Math.Round(i.EstimatedCost / i.Quantity, 2) : 0,
                TotalCost = i.EstimatedCost,
                AvailableStockAtExecution = i.CurrentStockAvailable,
                Notes = i.Notes
            }).ToList();

            var response = await Http.PostAsJsonAsync("api/warehouse/production/orders", _model);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("تم إنشاء أمر التشغيل والإنتاج بنجاح!", MudBlazor.Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"فشل في حفظ أمر الإنتاج: {error}", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
