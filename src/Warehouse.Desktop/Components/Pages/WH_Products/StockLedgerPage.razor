@page "/inventory/ledger"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using System.Net.Http.Json
@using System.Text.Json
@using System.Globalization
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject BlazorBase.Services.LocalizationService LocalizerService

<div class="wh-page-wrapper" dir="@(IsArabic ? "rtl" : "ltr")">
    <div class="wh-page-header mb-4">
        <MudText MudBlazor.Typo="Typo.h5" Class="wh-header-title" Style="font-weight: 800;">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Class="me-2" />
            دفتر حركات المخزون (Stock Ledger)
        </MudText>
    </div>

    <MudCard Class="wh-card mb-4" Elevation="1">
        <MudCardContent>
            <MudGrid Spacing="3" Class="align-end">
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color: #475569;">من تاريخ</MudText>
                    <MudDatePicker @bind-Date="DateFrom" Variant="MudBlazor.Variant.Outlined"
                                   DateFormat="yyyy/MM/dd" Editable="true" Margin="Margin.Dense"
                                   Culture="@(IsArabic ? new CultureInfo("ar-EG") : new CultureInfo("en-US"))" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color: #475569;">إلى تاريخ</MudText>
                    <MudDatePicker @bind-Date="DateTo" Variant="MudBlazor.Variant.Outlined"
                                   DateFormat="yyyy/MM/dd" Editable="true" Margin="Margin.Dense"
                                   Culture="@(IsArabic ? new CultureInfo("ar-EG") : new CultureInfo("en-US"))" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color: #475569;">المستودع</MudText>
                    <MudSelect T="int?" @bind-Value="SelectedWarehouseId"
                               Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense"
                               AnchorOrigin="Origin.BottomCenter" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">-- كل المستودعات --</MudSelectItem>
                        @foreach (var wh in Warehouses)
                        {
                            <MudSelectItem T="int?" Value="@((int?)wh.Id)">@wh.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color: #475569;">المنتج</MudText>
                    <MudSelect T="int?" @bind-Value="SelectedProductId"
                               Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense"
                               AnchorOrigin="Origin.BottomCenter" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">-- كل المنتجات --</MudSelectItem>
                        @foreach (var p in Products)
                        {
                            <MudSelectItem T="int?" Value="@((int?)p.Id)">@p.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudText Typo="MudBlazor.Typo.caption" Class="fw-bold mb-1 d-block" Style="color: #475569;">نوع الحركة</MudText>
                    <MudSelect T="string" @bind-Value="SelectedTransactionType"
                               Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@("All")">الكل</MudSelectItem>
                        <MudSelectItem T="string" Value="@("GoodsReceipt")">استلام بضاعة (GRN)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("GRN")">استلام بضاعة (GRN كود)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("BranchIssue")">صرف للفرع</MudSelectItem>
                        <MudSelectItem T="string" Value="@("BranchDispatch")">صرف للفرع (Dispatch)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("TransferIn")">دخول تحويل مخزني</MudSelectItem>
                        <MudSelectItem T="string" Value="@("TransferOut")">خروج تحويل مخزني</MudSelectItem>
                        <MudSelectItem T="string" Value="@("InventoryAdjustment")">تسوية جرد</MudSelectItem>
                        <MudSelectItem T="string" Value="@("SupplierReturn")">مردودات لمورد</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="8" Class="d-flex align-end gap-2 pb-1">
                    <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning" OnClick="LoadLedger"
                               StartIcon="@Icons.Material.Filled.Search" Style="height: 40px; border-radius: 8px; font-weight: 700;">بحث</MudButton>
                    <MudButton Variant="MudBlazor.Variant.Outlined" OnClick="ResetFilters"
                               StartIcon="@Icons.Material.Filled.Clear" Style="height: 40px; border-radius: 8px;">إعادة تعيين</MudButton>
                    <MudChip T="string" Color="MudBlazor.Color.Default" Variant="MudBlazor.Variant.Outlined" Style="height: 40px;">
                        عدد الحركات: @AllEntries.Count
                    </MudChip>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    @if (IsLoading)
    {
        <MudProgressLinear Color="MudBlazor.Color.Warning" Indeterminate="true" Class="mb-2" />
    }

    <MudCard Class="wh-card" Elevation="1">
        <MudCardContent>
            <MudTable Items="PagedItems" Dense="true" Hover="true" Striped="true"
                      Loading="IsLoading" LoadingProgressColor="MudBlazor.Color.Warning">
                <HeaderContent>
                    <MudTh>التاريخ</MudTh>
                    <MudTh>رقم المرجع</MudTh>
                    <MudTh>نوع الحركة</MudTh>
                    <MudTh>المنتج</MudTh>
                    <MudTh>المستودع</MudTh>
                    <MudTh>الكمية</MudTh>
                    <MudTh>الوحدة</MudTh>
                    <MudTh>سعر التكلفة</MudTh>
                    <MudTh>ملاحظات</MudTh>
                    <MudTh>بواسطة</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="التاريخ">@context.Date.ToString("yyyy/MM/dd HH:mm")</MudTd>
                    <MudTd DataLabel="رقم المرجع">
                        <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Default" Variant="MudBlazor.Variant.Outlined" Style="font-weight: 600;">
                            @context.TransactionRef
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="نوع الحركة">
                        <MudChip T="string" Size="MudBlazor.Size.Small" Color="@GetTypeColor(context.TransactionType)">
                            @GetTypeLabel(context.TransactionType)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="المنتج">
                        <span style="font-weight: 700;">@context.ProductName</span>
                    </MudTd>
                    <MudTd DataLabel="المستودع">@context.WarehouseName</MudTd>
                    <MudTd DataLabel="الكمية">
                        <MudText Color="@(context.Qty >= 0 ? MudBlazor.Color.Success : MudBlazor.Color.Error)"
                                 Class="font-weight-bold">
                            @(context.Qty >= 0 ? "+" : "")@context.Qty
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="الوحدة">@(string.IsNullOrEmpty(context.UnitName) ? "-" : context.UnitName)</MudTd>
                    <MudTd DataLabel="سعر التكلفة">@context.CostPrice.ToString("N2")</MudTd>
                    <MudTd DataLabel="ملاحظات">
                        <MudTooltip Text="@context.Notes">
                            <MudText Style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @(string.IsNullOrEmpty(context.Notes) ? "-" : context.Notes)
                            </MudText>
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="بواسطة">@(string.IsNullOrEmpty(context.CreatedBy) ? "النظام" : context.CreatedBy)</MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd colspan="5">
                        <MudText Class="font-weight-bold pa-2">صافي الحركات (الإجمالي)</MudText>
                    </MudTd>
                    <MudTd>
                        <MudText Color="@(NetQty >= 0 ? MudBlazor.Color.Success : MudBlazor.Color.Error)" Class="font-weight-bold pa-2">
                            @(NetQty >= 0 ? "+" : "")@NetQty
                        </MudText>
                    </MudTd>
                    <MudTd colspan="4"></MudTd>
                </FooterContent>
                <NoRecordsContent>
                    <MudText MudBlazor.Align="MudBlazor.Align.Center" Class="pa-4 mud-text-secondary">لا توجد حركات مخزون مطابقة للبحث</MudText>
                </NoRecordsContent>
            </MudTable>

            <div class="d-flex justify-center mt-4">
                <MudPagination Count="TotalPages" @bind-Selected="CurrentPage" Color="MudBlazor.Color.Warning"
                               BoundaryCount="2" MiddleCount="3" />
            </div>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private class WarehouseDto
    {
        public int Id { get; set; }
        public string? NameAr { get; set; }
        public string? NameEn { get; set; }
        public string? Name { get; set; }
        public string DisplayName => !string.IsNullOrWhiteSpace(NameAr) ? NameAr : (!string.IsNullOrWhiteSpace(Name) ? Name : (NameEn ?? $"مستودع {Id}"));
    }

    private class ProductDto
    {
        public int Id { get; set; }
        public string? NameAr { get; set; }
        public string? NameEn { get; set; }
        public string? Name { get; set; }
        public string? SKU { get; set; }
        public string DisplayName => !string.IsNullOrWhiteSpace(NameAr) ? NameAr : (!string.IsNullOrWhiteSpace(Name) ? Name : (NameEn ?? SKU ?? $"صنف {Id}"));
    }

    public class LedgerEntryDto
    {
        public DateTime Date { get; set; }
        public DateTime MovementDate { get; set; }
        public string TransactionRef { get; set; } = "";
        public string TransactionType { get; set; } = "";
        public string ProductName { get; set; } = "";
        public string WarehouseName { get; set; } = "";
        public decimal Qty { get; set; }
        public string UnitName { get; set; } = "";
        public decimal CostPrice { get; set; }
        public string? Notes { get; set; }
        public string CreatedBy { get; set; } = "";
    }

    private class PagedLedgerResult
    {
        public int Total { get; set; }
        public List<LedgerEntryDto>? Items { get; set; }
    }

    private List<WarehouseDto> Warehouses = new();
    private List<ProductDto> Products = new();
    private List<LedgerEntryDto> AllEntries = new();

    private DateTime? DateFrom = DateTime.Today.AddMonths(-1);
    private DateTime? DateTo = DateTime.Today;
    private int? SelectedWarehouseId;
    private int? SelectedProductId;
    private string SelectedTransactionType = "All";
    private bool IsLoading = false;
    private bool IsArabic => LocalizerService.GetCurrentLanguage() == "ar";
    private int CurrentPage = 1;
    private int PageSize = 20;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)AllEntries.Count / PageSize));
    private decimal NetQty => AllEntries.Sum(e => e.Qty);

    private List<LedgerEntryDto> PagedItems =>
        AllEntries.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var whs = await Http.GetFromJsonAsync<List<WarehouseDto>>("api/warehouse/warehouses");
            Warehouses = whs ?? new();
        }
        catch
        {
            try { Warehouses = await Http.GetFromJsonAsync<List<WarehouseDto>>("api/warehouses") ?? new(); }
            catch { }
        }

        try
        {
            var prods = await Http.GetFromJsonAsync<List<ProductDto>>("api/warehouseproducts/summary");
            Products = prods ?? new();
        }
        catch
        {
            try { Products = await Http.GetFromJsonAsync<List<ProductDto>>("api/products/lookup") ?? new(); }
            catch { }
        }

        await LoadLedger();
    }

    private async Task LoadLedger()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var url = "api/warehouseproducts/stock-ledger?";
            if (DateFrom.HasValue) url += $"from={DateFrom:yyyy-MM-dd}&";
            if (DateTo.HasValue) url += $"to={DateTo:yyyy-MM-dd}&";
            if (SelectedWarehouseId.HasValue) url += $"warehouseId={SelectedWarehouseId}&";
            if (SelectedProductId.HasValue) url += $"productId={SelectedProductId}&";

            var cleanUrl = url.TrimEnd('&', '?');
            using var response = await Http.GetAsync(cleanUrl);
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

                if (content.TrimStart().StartsWith("["))
                {
                    AllEntries = JsonSerializer.Deserialize<List<LedgerEntryDto>>(content, options) ?? new();
                }
                else
                {
                    var paged = JsonSerializer.Deserialize<PagedLedgerResult>(content, options);
                    AllEntries = paged?.Items ?? new();
                }

                if (SelectedTransactionType != "All")
                {
                    AllEntries = AllEntries.Where(e =>
                        string.Equals(e.TransactionType, SelectedTransactionType, StringComparison.OrdinalIgnoreCase) ||
                        (SelectedTransactionType == "GRN" && e.TransactionType == "GoodsReceipt") ||
                        (SelectedTransactionType == "BranchDispatch" && e.TransactionType == "BranchIssue")
                    ).ToList();
                }
            }
            else
            {
                Snackbar.Add($"تعذر جلب سجل الحركات (رمز: {response.StatusCode})", MudBlazor.Severity.Warning);
            }

            CurrentPage = 1;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في تحميل الدفتر: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void ResetFilters()
    {
        DateFrom = DateTime.Today.AddMonths(-1);
        DateTo = DateTime.Today;
        SelectedWarehouseId = null;
        SelectedProductId = null;
        SelectedTransactionType = "All";
        AllEntries = new();
        StateHasChanged();
    }

    private Color GetTypeColor(string type) => type switch
    {
        "GoodsReceipt" or "GRN" => MudBlazor.Color.Success,
        "BranchIssue" or "BranchDispatch" => MudBlazor.Color.Warning,
        "TransferIn" or "Transfer" => MudBlazor.Color.Info,
        "TransferOut" => MudBlazor.Color.Tertiary,
        "InventoryAdjustment" or "Adjustment" => MudBlazor.Color.Default,
        "SupplierReturn" or "Return" => MudBlazor.Color.Secondary,
        _ => MudBlazor.Color.Default
    };

    private string GetTypeLabel(string type) => type switch
    {
        "GoodsReceipt" or "GRN" => "استلام بضاعة (GRN)",
        "BranchIssue" or "BranchDispatch" => "صرف للفرع",
        "TransferIn" => "دخول تحويل",
        "TransferOut" => "خروج تحويل",
        "InventoryAdjustment" or "Adjustment" => "تسوية جرد",
        "SupplierReturn" or "Return" => "مردودات لمورد",
        "WasteDamage" => "تالف / هالك",
        _ => type
    };
}
