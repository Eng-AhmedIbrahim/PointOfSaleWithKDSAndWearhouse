@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject BlazorBase.Services.LocalizationService LocalizerService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<div class="top-nav-professional" dir="@(IsArabic ? "rtl" : "ltr")">
    <!-- Brand & Warehouse Badge -->
    <div class="nav-brand">
        <div class="logo-container" @onclick='() => NavigateTo("/")' style="cursor: pointer; display: flex; align-items: center; gap: 10px;">
            <img src="images/Logo.png" alt="Warehouse Logo" style="height: 44px; width: auto; object-fit: contain;" />
            <div class="brand-text-block">
                <span class="brand-title-main">@(IsArabic ? "إدارة المخزن الرئيسي" : "Main Warehouse System")</span>
                <span class="brand-badge-role">@(IsArabic ? "اللوجستيات والإمداد" : "Central Supply Hub")</span>
            </div>
        </div>
    </div>

    <!-- Clean Warehouse Navigation Menu -->
    <div class="nav-tabs-container">
        <!-- 1. Dashboard -->
        <div class="tab-item @(IsActive("/") ? "active" : "")" @onclick='() => NavigateTo("/")'>
            <MudIcon Icon="@Icons.Material.Rounded.Dashboard" Size="Size.Small" Class="tab-icon" />
            <span class="tab-text">@(IsArabic ? "لوحة التحكم" : "Dashboard")</span>
        </div>

        <!-- 2. Warehouses & Branches -->
        <div class="tab-item @(IsActive("/warehouses") ? "active" : "")" @onclick='() => NavigateTo("/warehouses")'>
            <MudIcon Icon="@Icons.Material.Rounded.HomeWork" Size="Size.Small" Class="tab-icon" />
            <span class="tab-text">@(IsArabic ? "المستودعات والفروع" : "Warehouses")</span>
        </div>

        <!-- 3. Products & Inventory Units Menu -->
        <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" ListClass="pa-2" PopoverClass="settings-menu-popover">
            <ActivatorContent>
                <div class="tab-item @(IsActivePrefix("/products") || IsActivePrefix("/inventory") ? "active" : "")">
                    <MudIcon Icon="@Icons.Material.Rounded.Inventory2" Size="Size.Small" Class="tab-icon" />
                    <span class="tab-text">@(IsArabic ? "الأصناف والمخزون" : "Inventory")</span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Class="dropdown-arrow" />
                </div>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Href="/products">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.Category" Size="Size.Small" />
                        @(IsArabic ? "بطاقات الأصناف والوحدات" : "Products & Multi-Units")
                    </div>
                </MudMenuItem>
                <MudMenuItem Href="/inventory/balances">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.Balance" Size="Size.Small" />
                        @(IsArabic ? "أرصدة المخزون اللحظية" : "Stock Balances")
                    </div>
                </MudMenuItem>
                <MudMenuItem Href="/inventory/ledger">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.FormatListNumbered" Size="Size.Small" />
                        @(IsArabic ? "سجل حركة المخزون (Stock Ledger)" : "Stock Ledger")
                    </div>
                </MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Href="/inventory/adjustments">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.Rule" Size="Size.Small" />
                        @(IsArabic ? "الجرد الدوري والتسويات" : "Stocktake & Adjustments")
                    </div>
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <!-- 4. Suppliers Menu -->
        <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" ListClass="pa-2" PopoverClass="settings-menu-popover">
            <ActivatorContent>
                <div class="tab-item @(IsActivePrefix("/suppliers") ? "active" : "")">
                    <MudIcon Icon="@Icons.Material.Rounded.PeopleAlt" Size="Size.Small" Class="tab-icon" />
                    <span class="tab-text">@(IsArabic ? "الموردين" : "Suppliers")</span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Class="dropdown-arrow" />
                </div>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Href="/suppliers">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.ContactPage" Size="Size.Small" />
                        @(IsArabic ? "دليل الموردين وشروط الدفع" : "Suppliers Directory")
                    </div>
                </MudMenuItem>
                <MudMenuItem Href="/suppliers/prices">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.PriceChange" Size="Size.Small" />
                        @(IsArabic ? "أسعار الموردين المتفق عليها" : "Supplier Pricing")
                    </div>
                </MudMenuItem>
                <MudMenuItem Href="/suppliers/accounts">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.AccountBalance" Size="Size.Small" />
                        @(IsArabic ? "كشف حسابات ومدفوعات الموردين" : "Supplier Ledger & Aging")
                    </div>
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <!-- 5. Purchasing & GRN -->
        <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" ListClass="pa-2" PopoverClass="settings-menu-popover">
            <ActivatorContent>
                <div class="tab-item @(IsActivePrefix("/purchasing") ? "active" : "")">
                    <MudIcon Icon="@Icons.Material.Rounded.ShoppingCart" Size="Size.Small" Class="tab-icon" />
                    <span class="tab-text">@(IsArabic ? "المشتريات والاستلام" : "Purchasing & GRN")</span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Class="dropdown-arrow" />
                </div>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Href="/purchasing/orders">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.PostAdd" Size="Size.Small" />
                        @(IsArabic ? "أوامر الشراء للموردين (PO)" : "Purchase Orders")
                    </div>
                </MudMenuItem>
                <MudMenuItem Href="/purchasing/grn">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.AssignmentTurnedIn" Size="Size.Small" />
                        @(IsArabic ? "أذون استلام المخزن (GRN)" : "Goods Receipt Notes")
                    </div>
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <!-- 6. Branch Requisitions -->
        <div class="tab-item @(IsActivePrefix("/requisitions") ? "active" : "")" @onclick='() => NavigateTo("/requisitions")'>
            <MudIcon Icon="@Icons.Material.Rounded.MoveToInbox" Size="Size.Small" Class="tab-icon" />
            <span class="tab-text">@(IsArabic ? "طلبات الفروع" : "Branch Requisitions")</span>
        </div>

        <!-- 7. Stock Transfers -->
        <div class="tab-item @(IsActivePrefix("/transfers") ? "active" : "")" @onclick='() => NavigateTo("/transfers")'>
            <MudIcon Icon="@Icons.Material.Rounded.LocalShipping" Size="Size.Small" Class="tab-icon" />
            <span class="tab-text">@(IsArabic ? "التحويلات والشحنات" : "Transfers")</span>
        </div>

        <!-- 8. Reports -->
        <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" ListClass="pa-2" PopoverClass="settings-menu-popover">
            <ActivatorContent>
                <div class="tab-item @(IsActivePrefix("/reports") ? "active" : "")">
                    <MudIcon Icon="@Icons.Material.Rounded.Assessment" Size="Size.Small" Class="tab-icon" />
                    <span class="tab-text">@(IsArabic ? "التقارير" : "Reports")</span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Class="dropdown-arrow" />
                </div>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Href="/reports/stock-valuation">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.MonetizationOn" Size="Size.Small" />
                        @(IsArabic ? "تقرير تقييم المخزون (بالتكلفة المرجحة)" : "Stock Valuation Report")
                    </div>
                </MudMenuItem>
                <MudMenuItem Href="/reports/item-movements">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.ShowChart" Size="Size.Small" />
                        @(IsArabic ? "كارت الصنف وحركة المخزون" : "Item Movement History")
                    </div>
                </MudMenuItem>
                <MudMenuItem Href="/reports/reorder-alerts">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.Warning" Size="Size.Small" />
                        @(IsArabic ? "نواقص المخزون وحد إعادة الطلب" : "Reorder Suggestions")
                    </div>
                </MudMenuItem>
                <MudMenuItem Href="/reports/supplier-aging">
                    <div class="menu-item-content">
                        <MudIcon Icon="@Icons.Material.Rounded.DateRange" Size="Size.Small" />
                        @(IsArabic ? "تقرير ديون ومستحقات الموردين" : "Supplier Aging")
                    </div>
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
    </div>

    <!-- Actions: Language & User & Logout -->
    <div class="nav-actions" style="margin-inline-start: auto; display: flex; align-items: center; gap: 12px;">
        <!-- Language Switcher -->
        <button class="nav-action-btn" @onclick="ToggleLanguage" title="@(IsArabic ? "English" : "العربية")">
            <MudIcon Icon="@Icons.Material.Rounded.Translate" Size="Size.Small" />
            <span class="action-btn-text">@(IsArabic ? "EN" : "عربي")</span>
        </button>

        <!-- Logout Button -->
        <button class="nav-action-btn logout-btn" @onclick="Logout" title="@(IsArabic ? "تسجيل خروج" : "Logout")">
            <MudIcon Icon="@Icons.Material.Rounded.Logout" Size="Size.Small" />
            <span class="action-btn-text">@(IsArabic ? "تسجيل خروج" : "Logout")</span>
        </button>
    </div>
</div>

@code {
    private bool IsArabic => LocalizerService.GetCurrentLanguage() == "ar";

    private bool IsActive(string path)
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (string.IsNullOrEmpty(relative) && path == "/") return true;
        return "/" + relative.TrimEnd('/') == path.TrimEnd('/');
    }

    private bool IsActivePrefix(string prefix)
    {
        var relative = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return relative.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    }

    private void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url);
    }

    private async Task ToggleLanguage()
    {
        var targetLang = IsArabic ? "en" : "ar";
        await LocalStorage.SetItemAsync("currentLanguage", targetLang);
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private async Task Logout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        if (AuthStateProvider is Warehouse.Desktop.Auth.CustomAuthenticationStateProvider customProvider)
        {
            await customProvider.NotifyUserLogout();
        }
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}
