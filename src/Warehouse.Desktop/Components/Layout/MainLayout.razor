@inherits LayoutComponentBase
@using MudBlazor.Utilities

<MudThemeProvider Theme="@_customTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@inject CommonProperties _commonProperties
@inject ISnackbar _snackbar
@inject BlazorBase.Services.LocalizationService Localizer
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject BlazorBase.ERPFrontServices.LicensingServices.ILicenseService LicenseService
@inject Warehouse.Desktop.Services.WarehouseNotificationService WarehouseNotification
@inject WarehouseNotificationInvocation WarehouseNotificationEvents
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

@implements IDisposable


<AuthorizeView>
    <Authorized>
        <div dir="@(IsArabic ? "rtl" : "ltr")">
            <MudLayout Style="height: 100vh;">
                <MudMainContent Class="main-content-wrapper py-0">
                    <NavMenu IsLicensedForWarehouse="_isLicensed" />
                    <div class="page-container">
                        @if (_isLicensed)
                        {
                            @Body
                        }
                        else if (_isConnectionError)
                        {
                            <div class="d-flex align-center justify-center flex-grow-1 mt-10" style="flex-direction:column; text-align:center;">
                                <MudIcon Icon="@Icons.Material.Filled.CloudOff" Style="font-size: 6rem;" Color="Color.Warning" Class="mb-4" />
                                <MudText Typo="Typo.h4" Color="Color.Warning" Class="mb-2">تعذر الاتصال بخادم النظام أو قاعدة البيانات</MudText>
                                <MudText Typo="Typo.body1" Class="mb-4" Style="max-width: 500px;">@(_connectionErrorMessage ?? "يرجى التأكد من تشغيل سيرفر الـ API وقاعدة البيانات والاتصال بالشبكة.")</MudText>
                                <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" 
                                           OnClick="CheckLicenseAndConnectionAsync" Disabled="_isCheckingConnection">
                                    @(_isCheckingConnection ? "جاري الفحص..." : "إعادة المحاولة")
                                </MudButton>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-center justify-center flex-grow-1 mt-10" style="flex-direction:column; text-align:center;">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size: 6rem; color: #ea580c;" Class="mb-4" />
                                <MudText Typo="Typo.h4" Style="color: #ea580c; font-weight: 800;" Class="mb-2">هذا الجهاز غير مرخص لنظام المخازن</MudText>
                                <MudText Typo="Typo.body1" Class="mb-5" Style="color: #64748b; font-size: 1.1rem;">برجاء الضغط على زر "التسجيل" لتفعيل ترخيص المخزن لهذا الجهاز أو الرجوع للإدارة.</MudText>
                                <MudButton Variant="MudBlazor.Variant.Filled" Size="Size.Large" StartIcon="@Icons.Material.Rounded.AppRegistration"
                                           OnClick="OpenRegistrationDialog" Style="background: #ea580c; color: white; font-weight: 700; font-size: 1.1rem; border-radius: 12px; padding: 10px 28px;">
                                    تسجيل وتفعيل ترخيص المخزن
                                </MudButton>
                            </div>
                        }
                    </div>
                </MudMainContent>

            </MudLayout>
        </div>
        <RadzenDialog />
        <RadzenNotification />
        <RadzenContextMenu />
    </Authorized>
    <NotAuthorized>
        @Body
        <RadzenDialog />
        <RadzenNotification />
        <RadzenContextMenu />
    </NotAuthorized>
</AuthorizeView>

@code {
    bool _drawerOpen = true;
    bool _isMini = false;
    bool _isLicensed = false;
    bool _isConnectionError = false;
    string? _connectionErrorMessage = null;
    bool _isCheckingConnection = false;

    private bool IsArabic => Localizer.GetCurrentLanguage() == "ar";


    private void ToggleMini()
    {
        _isMini = !_isMini;
    }

    private MudTheme _customTheme = new()
    {
        PaletteLight = new PaletteLight()
        {
            DrawerBackground = new MudColor("#1c0f08"), // Slate 900
            DrawerText = new MudColor("#fed7aa"),
            DrawerIcon = new MudColor("#fb923c"),
            Primary = new MudColor("#ea580c"), // BlueSky from logo
            Secondary = new MudColor("#f97316"),
            AppbarBackground = new MudColor("#ffffff"),
            Background = new MudColor("#fffbf5"),
            TextPrimary = new MudColor("#431407")
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Tajawal", "Roboto", "Helvetica", "Arial", "sans-serif" }
            },
            Button = new ButtonTypography()
            {
                TextTransform = "none"
            }
        }
    };

    private Action? _stateChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        await CheckLicenseAndConnectionAsync();

        // Initialize warehouse SignalR connection
        await WarehouseNotification.InitializeAsync();

        // Subscribe to warehouse notifications -> show snackbar
        WarehouseNotificationEvents.OnShowWarehouseNotification += HandleWarehouseNotification;

        _stateChangedHandler = async () => 
        {
            try { await InvokeAsync(StateHasChanged); } catch { }
        };

        _commonProperties.OnChange += _stateChangedHandler;
    }

    private async Task CheckLicenseAndConnectionAsync()
    {
        _isCheckingConnection = true;
        try
        {
            var res = await LicenseService.VerifyDeviceLicenseAsync("Warehouse");
            if (res.IsConnectionError)
            {
                _isConnectionError = true;
                _isLicensed = false;
                _connectionErrorMessage = res.ErrorMessage;
            }
            else
            {
                _isConnectionError = false;
                _isLicensed = res.IsLicensed;
                _connectionErrorMessage = null;
            }
        }
        catch
        {
            _isConnectionError = true;
            _isLicensed = false;
            _connectionErrorMessage = "تعذر الاتصال بسيرفر النظام (API). يرجى التأكد من تشغيل السيرفر.";
        }
        finally
        {
            _isCheckingConnection = false;
            StateHasChanged();
        }
    }

    private async Task OpenRegistrationDialog()
    {
        var options = new MudBlazor.DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, NoHeader = false };
        var dialog = await DialogService.ShowAsync<Warehouse.Desktop.Components.Shared.LicenseActivationDialog>(
            IsArabic ? "تنشيط ترخيص المخزن" : "Activate Warehouse License", 
            options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await CheckLicenseAndConnectionAsync();
        }
    }


    public void Dispose()
    {
        if (_stateChangedHandler != null)
        {
            _commonProperties.OnChange -= _stateChangedHandler;
        }
        WarehouseNotificationEvents.OnShowWarehouseNotification -= HandleWarehouseNotification;
    }

    private void HandleWarehouseNotification(string title, string message, MudBlazor.Severity severity)
    {
        InvokeAsync(() =>
        {
            _snackbar.Add($"[{title}] {message}", severity);
        });
    }
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">ðŸ—™</a>
</div>

