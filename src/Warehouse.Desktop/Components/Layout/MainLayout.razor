    @@import url('fonts.css');

    .main-content-wrapper {
        background-color: #f8fafc;
        height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .page-container {
        height: calc(100vh - 72px);
        overflow-y: auto;
        width: 100%;
        display: flex;
        flex-direction: column;
    }
</style>

