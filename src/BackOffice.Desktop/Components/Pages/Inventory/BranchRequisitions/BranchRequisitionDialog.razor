@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject CommonProperties CommonProps

<MudDialog dir="rtl" Style="max-width: 850px; border-radius: 16px;">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Rounded.AddShoppingCart" Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Large" />
            <div>
                <MudText Typo="MudBlazor.Typo.h6" Style="font-weight: 800; color: #1e293b;">
                    إنشاء طلب توريد من المخزن الرئيسي
                </MudText>
                <MudText Typo="MudBlazor.Typo.caption" Color="MudBlazor.Color.Secondary">
                    اختر المستودع المورد والأصناف والكميات والوحدات المطلوبة
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="pa-2">
            <!-- Header Config -->
            <MudGrid Class="mb-3">
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="المستودع المورد المستهدف *" Value="_targetWarehouseId" ValueChanged="OnTargetWarehouseChanged"
                               Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense">
                        @foreach (var wh in _warehouses)
                        {
                            <MudSelectItem Value="@wh.Id">@wh.NameAr (@wh.Code)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="تاريخ التوريد المطلوب" @bind-Date="_requiredDate"
                                   Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="ملاحظات إضافية على الطلبية (اختياري)" @bind-Value="_notes"
                                  Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" Lines="1" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_targetWarehouseApiUrl))
            {
                <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="mb-3">
                    سيتم إرسال الطلب إلى سيرفر المخزن: <strong>@_targetWarehouseApiUrl</strong>
                </MudAlert>
            }

            <!-- Add Item Row -->
            <MudPaper Class="pa-3 mb-3 rounded-xl" Elevation="0" Style="background: #fffaf5; border: 1px dashed #f97316;">
                <div class="d-flex align-center gap-2 mb-2">
                    <MudIcon Icon="@Icons.Material.Rounded.AddBox" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Warning" />
                    <MudText Typo="MudBlazor.Typo.subtitle2" Style="font-weight: 800; color: #ea580c;">
                        + إضافة صنف من أصناف المخزن الرئيسي
                    </MudText>
                </div>
                
                <MudGrid Spacing="2" Class="align-center">
                    <MudItem xs="12" sm="5">
                        <MudAutocomplete T="ProductLookup" Label="ابحث باسم الصنف أو كود SKU..." Value="_selectedProduct" ValueChanged="OnProductSelected"
                                         SearchFunc="@SearchProducts" ToStringFunc="@(p => p != null ? $"{p.NameAr} ({p.SKU})" : "")"
                                         Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense"
                                         ResetValueOnEmptyText="true" CoerceText="false" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudSelect T="int" Label="الوحدة *" @bind-Value="_selectedUnitId"
                                   Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense"
                                   Disabled="@(_selectedProduct == null || !_availableUnits.Any())">
                            @foreach (var u in _availableUnits)
                            {
                                <MudSelectItem Value="@u.UnitId">@u.UnitName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudNumericField T="decimal" Label="الكمية *" @bind-Value="_newQuantity" Min="0.1m"
                                         Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudButton Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning" FullWidth="true"
                                   OnClick="AddItem" StartIcon="@Icons.Material.Rounded.Add" Style="height: 40px; font-weight: 700; border-radius: 8px;"
                                   Disabled="@(_selectedProduct == null || _newQuantity <= 0)">
                            إضافة
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Items Table -->
            <MudTable Items="@_items" Dense="true" Hover="true" Elevation="1" Class="border rounded-xl mb-2">
                <HeaderContent>
                    <MudTh Style="background: #f8fafc; font-weight: 800;">#</MudTh>
                    <MudTh Style="background: #f8fafc; font-weight: 800;">اسم الصنف</MudTh>
                    <MudTh Style="background: #f8fafc; font-weight: 800;">الكود (SKU)</MudTh>
                    <MudTh Style="background: #f8fafc; font-weight: 800;">الوحدة المطلوبة</MudTh>
                    <MudTh Style="background: #f8fafc; font-weight: 800; width: 140px;">الكمية المطلوبة</MudTh>
                    <MudTh Style="background: #f8fafc; font-weight: 800; width: 60px;">حذف</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(_items.IndexOf(context) + 1)</MudTd>
                    <MudTd Style="font-weight: 700;">@context.ProductName</MudTd>
                    <MudTd><MudChip T="string" Size="MudBlazor.Size.Small" Variant="MudBlazor.Variant.Outlined" Color="MudBlazor.Color.Primary">@context.SKU</MudChip></MudTd>
                    <MudTd><MudChip T="string" Size="MudBlazor.Size.Small" Variant="MudBlazor.Variant.Text" Color="MudBlazor.Color.Dark">@context.UnitName</MudChip></MudTd>
                    <MudTd>
                        <MudNumericField T="decimal" @bind-Value="context.RequestedQuantity" Min="0.1m"
                                         Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" Style="max-width: 110px;" />
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Rounded.Delete" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small"
                                       OnClick="@(() => _items.Remove(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-6 text-center text-muted">
                        <MudIcon Icon="@Icons.Material.Rounded.RemoveShoppingCart" Style="font-size: 2.5rem; opacity: 0.3;" />
                        <MudText Typo="MudBlazor.Typo.body2" Class="mt-2" Style="color: #64748b;">
                            لم تتم إضافة أي أصناف للطلبية بعد. استخدم محقل البحث والوحدة أعلاه لإضافة الأصناف.
                        </MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="d-flex justify-space-between align-center w-100 px-4 pb-3">
            <MudButton OnClick="Cancel" Variant="MudBlazor.Variant.Text">إلغاء</MudButton>
            <MudButton OnClick="SubmitRequisition" Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Warning"
                       Disabled="@(_items.Count == 0 || _targetWarehouseId == 0 || _isSubmitting)"
                       StartIcon="@Icons.Material.Rounded.Send" Style="border-radius: 10px; font-weight: 800; min-width: 140px;">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Indeterminate="true" Size="MudBlazor.Size.Small" Class="me-2" />
                    <span>جاري الإرسال...</span>
                }
                else
                {
                    <span>إرسال طلب التوريد</span>
                }
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private int _targetWarehouseId;
    private string? _targetWarehouseApiUrl;
    private DateTime? _requiredDate = DateTime.Today.AddDays(2);
    private string? _notes;
    private bool _isSubmitting = false;

    private List<WarehouseLookup> _warehouses = new();
    private List<ProductLookup> _allProducts = new();
    private ProductLookup? _selectedProduct;
    private int _selectedUnitId;
    private List<UnitItemLookup> _availableUnits = new();
    private decimal _newQuantity = 1;

    private List<RequisitionItemVm> _items = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var whList = await Http.GetFromJsonAsync<List<WarehouseLookup>>("api/warehouse/warehouses");
            if (whList != null) _warehouses = whList;

            // Default warehouse for branch if set
            var defaultWhId = CommonProps.BranchDetails?.DefaultWarehouseId;
            if (defaultWhId.HasValue && _warehouses.Any(w => w.Id == defaultWhId.Value))
                _targetWarehouseId = defaultWhId.Value;
            else if (_warehouses.Any())
                _targetWarehouseId = _warehouses.First().Id;

            UpdateTargetWarehouseApiUrl();
            await LoadProducts();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ أثناء التحميل: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task OnTargetWarehouseChanged(int warehouseId)
    {
        _targetWarehouseId = warehouseId;
        UpdateTargetWarehouseApiUrl();
        await LoadProducts();
    }

    private void UpdateTargetWarehouseApiUrl()
    {
        _targetWarehouseApiUrl = _warehouses.FirstOrDefault(w => w.Id == _targetWarehouseId)?.ApiUrl;
    }

    private async Task LoadProducts()
    {
        try
        {
            List<ProductLookup>? prodList = null;

            // إذا كان المخزن له سيرفر API خارجي محدد
            if (!string.IsNullOrWhiteSpace(_targetWarehouseApiUrl))
            {
                try
                {
                    using var extClient = new System.Net.Http.HttpClient { Timeout = TimeSpan.FromSeconds(6) };
                    extClient.BaseAddress = new Uri(_targetWarehouseApiUrl.TrimEnd('/') + "/");
                    prodList = await extClient.GetFromJsonAsync<List<ProductLookup>>("api/warehouse/products");
                }
                catch { /* Fallback to local if remote unreachable */ }
            }

            // Fallback: جلب من الـ API المحلي
            if (prodList == null || !prodList.Any())
            {
                prodList = await Http.GetFromJsonAsync<List<ProductLookup>>("api/warehouse/products");
            }

            if (prodList != null)
                _allProducts = prodList;
        }
        catch { }
    }

    private void OnProductSelected(ProductLookup? prod)
    {
        _selectedProduct = prod;
        _availableUnits.Clear();

        if (prod != null)
        {
            // أضف الوحدة الأساسية
            var baseName = !string.IsNullOrWhiteSpace(prod.BaseUnitName) 
                ? prod.BaseUnitName 
                : (prod.BaseUnit?.NameAr ?? "وحدة أساسية");

            _availableUnits.Add(new UnitItemLookup
            {
                UnitId = prod.BaseUnitId > 0 ? prod.BaseUnitId : 1,
                UnitName = baseName
            });

            // أضف أي وحدات فرعية إضافية (كرتونة، باكت، إلخ)
            if (prod.Units != null && prod.Units.Any())
            {
                foreach (var u in prod.Units)
                {
                    if (u.UnitId != prod.BaseUnitId && !_availableUnits.Any(x => x.UnitId == u.UnitId))
                    {
                        _availableUnits.Add(new UnitItemLookup
                        {
                            UnitId = u.UnitId,
                            UnitName = u.UnitName ?? "وحدة"
                        });
                    }
                }
            }

            _selectedUnitId = _availableUnits.First().UnitId;
        }
    }

    private Task<IEnumerable<ProductLookup>> SearchProducts(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<ProductLookup>>(_allProducts.Take(25));

        var q = _allProducts.Where(p =>
            (p.NameAr != null && p.NameAr.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (p.SKU != null && p.SKU.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (p.NameEn != null && p.NameEn.Contains(value, StringComparison.OrdinalIgnoreCase)));

        return Task.FromResult(q);
    }

    private void AddItem()
    {
        if (_selectedProduct == null || _newQuantity <= 0) return;

        var unitName = _availableUnits.FirstOrDefault(u => u.UnitId == _selectedUnitId)?.UnitName ?? "وحدة";

        var existing = _items.FirstOrDefault(i => i.ProductId == _selectedProduct.Id && i.UnitId == _selectedUnitId);
        if (existing != null)
        {
            existing.RequestedQuantity += _newQuantity;
        }
        else
        {
            _items.Add(new RequisitionItemVm
            {
                ProductId = _selectedProduct.Id,
                ProductName = _selectedProduct.NameAr ?? "",
                SKU = _selectedProduct.SKU ?? "",
                UnitId = _selectedUnitId,
                UnitName = unitName,
                RequestedQuantity = _newQuantity
            });
        }

        _selectedProduct = null;
        _availableUnits.Clear();
        _newQuantity = 1;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitRequisition()
    {
        if (_targetWarehouseId == 0 || _items.Count == 0) return;

        var branchId = CommonProps.BranchDetails?.Id ?? 1;
        _isSubmitting = true;

        try
        {
            var model = new
            {
                RequestingBranchId = branchId,
                TargetWarehouseId = _targetWarehouseId,
                RequiredDate = _requiredDate,
                Notes = _notes,
                Status = 2, // Submitted
                Lines = _items.Select(i => new
                {
                    ProductId = i.ProductId,
                    UnitId = i.UnitId,
                    RequestedQuantity = i.RequestedQuantity
                }).ToList()
            };

            HttpResponseMessage res;
            var warehouseApiUrl = _warehouses.FirstOrDefault(w => w.Id == _targetWarehouseId)?.ApiUrl;

            if (!string.IsNullOrWhiteSpace(warehouseApiUrl))
            {
                using var externalClient = new System.Net.Http.HttpClient { Timeout = TimeSpan.FromSeconds(15) };
                externalClient.BaseAddress = new Uri(warehouseApiUrl.TrimEnd('/') + "/");
                res = await externalClient.PostAsJsonAsync("api/warehouse/requisitions", model);
            }
            else
            {
                res = await Http.PostAsJsonAsync("api/warehouse/requisitions", model);
            }

            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("تم إرسال طلب التوريد إلى المخزن الرئيسي بنجاح", MudBlazor.Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add($"فشل إرسال الطلب: {err}", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class WarehouseLookup
    {
        public int Id { get; set; }
        public string? Code { get; set; }
        public string? NameAr { get; set; }
        public string? ApiUrl { get; set; }
    }

    public class ProductLookup
    {
        public int Id { get; set; }
        public string? SKU { get; set; }
        public string? NameAr { get; set; }
        public string? NameEn { get; set; }
        public int BaseUnitId { get; set; }
        public string? BaseUnitName { get; set; }
        public UnitLookup? BaseUnit { get; set; }
        public List<UnitItemLookup> Units { get; set; } = new();
    }

    public class UnitLookup
    {
        public int Id { get; set; }
        public string? NameAr { get; set; }
    }

    public class UnitItemLookup
    {
        public int UnitId { get; set; }
        public string? UnitName { get; set; }
    }

    public class RequisitionItemVm
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public string SKU { get; set; } = "";
        public int UnitId { get; set; }
        public string UnitName { get; set; } = "";
        public decimal RequestedQuantity { get; set; }
    }
}